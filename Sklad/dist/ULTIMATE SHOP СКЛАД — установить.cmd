        <article class="w wm" data-go="buy" tabindex="0" aria-labelledby="wBuyH">
          <header class="wh"><span class="wi gold"><svg class="ic"><use href="#i-buy"/></svg></span><h3 id="wBuyH">Закупка</h3><span class="wmeta" id="hBuyM"></span></header>
          <ul class="hbuy" id="hBuy"></ul>
          <div class="wfoot" id="hBuyF"></div>
        </article>
        <article class="w" data-go="an" tabindex="0" aria-labelledby="wDeadH">
