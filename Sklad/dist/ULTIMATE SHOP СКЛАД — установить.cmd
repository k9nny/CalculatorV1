.tile .v{font:700 30px/1.05 var(--f-display);font-variant-numeric:tabular-nums}
.tile .v small{font:600 15px var(--f-ui);margin-left:6px}
.tile .s{font-size:14px;color:var(--muted)}
.tile.hot{background:var(--accent);border-color:var(--accent-edge);color:var(--accent-ink)}
.tile.hot .k,.tile.hot .s{color:var(--accent-ink);opacity:.78}
.seg{display:inline-flex;border:1.5px solid var(--line);border-radius:8px;overflow:hidden;flex-wrap:wrap}
.seg button{appearance:none;border:0;background:transparent;color:var(--muted);font:600 13px/1 var(--f-ui);padding:11px 12px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.ometa{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;margin-top:12px;font-size:14px;color:var(--muted)}
