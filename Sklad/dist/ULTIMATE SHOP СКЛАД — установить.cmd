.opt b{display:block;font-weight:600}
.opt span{color:var(--muted);font-size:14px}
code.k{font-family:var(--f-mono);background:var(--surface-2);border:1px solid var(--line);border-radius:4px;padding:0 5px;font-size:13px;color:var(--ink)}
.tester{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:end;margin-top:16px}
