body.emp .onlyemp{display:inline}
.helpbtn.empexit{text-align:left}
body.emp .empbadge{display:block;margin:-8px 8px 0;padding:6px 10px;border-radius:8px;background:color-mix(in srgb,var(--side-gold) 18%,transparent);color:var(--side-gold);font:600 11.5px/1.2 var(--f-ui);letter-spacing:.08em;text-transform:uppercase;text-align:center}
body.emp .helpbtn.empexit{display:flex}
body.emp #t-home,body.emp #t-day,body.emp #t-buy,body.emp #t-an,body.emp #t-settings,body.emp .helpbtn.gear,body.emp .top .kpis,
body.emp #recvAsIs,body.emp [data-import="stock"],body.emp [data-paste="stock"],body.emp [data-export-stock],body.emp #rcReplace,body.emp #stSeg,body.emp #stBody [data-del],
body.emp [data-import="receipt"],body.emp [data-paste="receipt"],body.emp [data-cancel-pur],body.emp [data-recv-asis]{display:none!important}
@media (max-width:1023px){body.emp .empbadge{display:none}body.emp .helpbtn.empexit{width:34px;height:34px;padding:0;justify-content:center}body.emp .helpbtn.empexit span{display:none}}
.empcard{border-color:color-mix(in srgb,var(--gold) 45%,var(--line))}
.shake{animation:shake .45s}
@keyframes shake{20%{transform:translateX(-8px)}40%{transform:translateX(7px)}60%{transform:translateX(-5px)}80%{transform:translateX(3px)}}
/* celebration layer */
.confetti{position:fixed;inset:0;pointer-events:none;z-index:96}
@media (prefers-reduced-motion:reduce){
  .btn,.tile,.kpi,.ppc,.go,.w,.tabpill,.segthumb,.odo .odr,.opt input[type=checkbox],.step button{transition:none!important}
