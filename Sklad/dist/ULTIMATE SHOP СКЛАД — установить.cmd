.sz{width:auto;border-collapse:collapse;margin-top:8px;font-size:14px}
.sz th:nth-child(2),.sz td:nth-child(2){width:80px}.sz th:nth-child(3),.sz td:nth-child(3){width:100px}.sz td:nth-child(4){width:40px}
.sz th{font:600 11px/1.2 var(--f-ui);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:left;padding:4px 8px 6px 0}
.sz th.num,.sz td.num{text-align:right}
.sz td{padding:4px 8px 4px 0;border-top:1px solid var(--line);vertical-align:middle}
.sz td.size{font:700 15px var(--f-mono);width:70px}
.sz .qin{width:80px}
.plus{display:flex;gap:6px;align-items:center;margin-top:8px}
.plus .in{width:110px;padding:7px 9px;font-size:14px}
.plus .btn{min-height:36px;padding:7px 10px;font-size:13px}
.golist{display:grid;gap:8px}
.go{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;padding:12px 14px;border:1.5px solid var(--line);border-radius:8px}
.go b{font:800 15px var(--f-display)}
.go .sum{color:var(--muted);font-size:14px;margin-right:auto}
.go .btn{min-height:38px;padding:8px 12px}
.goall{display:flex;justify-content:flex-end}
.cnt{display:grid;grid-template-columns:minmax(64px,auto) 1fr auto;gap:8px 12px;align-items:center;padding:8px 0;border-top:1px solid var(--line)}
.cnt .size{font:700 18px var(--f-mono)}
.cnt .ord{color:var(--muted);font-size:14px}
.cnt.ok .ord{color:var(--good);font-weight:600}
.cnt.less .ord{color:var(--warn);font-weight:600}
.cnt.more .ord{color:var(--bad);font-weight:600}
.step{display:flex;align-items:center;gap:6px}
.step button{appearance:none;width:46px;height:46px;border-radius:10px;border:1.5px solid var(--line);background:var(--surface-2);color:var(--ink);font:600 22px/1 var(--f-ui);cursor:pointer}
.step button.pl{background:var(--accent);border-color:var(--accent-edge);color:var(--accent-ink)}
.step button:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.step .cin{width:60px;text-align:center;font:700 18px var(--f-mono);padding:10px 4px}
.sticky-actions{position:sticky;bottom:env(safe-area-inset-bottom,0px);z-index:3;box-shadow:0 -6px 20px rgba(0,0,0,.08)}
.recv-model{display:grid;gap:10px}
.rm-head{display:flex;gap:14px;align-items:center;min-width:0}
