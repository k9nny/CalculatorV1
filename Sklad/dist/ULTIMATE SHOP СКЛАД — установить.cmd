// buy
function askCommit(box) {
  const p = plan(), rows = buyRows(p).filter(r => r.order > 0);
  let take = 0; const tShips = new Set();
  for (const [k, r] of p) if (r.take > 0) { take += r.take; const ln = lines.items.get(k); tShips.add(ln.s || k); }
  const order = round(rows.reduce((s, r) => s + r.order, 0));
  let forOrders = 0; for (const r of rows) forOrders += Math.min(r.need, r.order);
  let notOrdered = 0; for (const r of buyRows(p, true)) notOrdered += r.skip ? r.need : Math.max(0, r.need - r.order);
  const pavs = new Set(rows.map(r => r.pav)).size;
  const parts = [];
  if (take) parts.push(`Со склада спишется <b>${fmt(round(take))} шт.</b> под ${cnt(tShips.size, W.ship)}.`);
  if (order) parts.push(`У поставщиков заказываем <b>${fmt(order)} шт.</b> ${inPav(pavs)}: ${fmt(round(forOrders))} шт. закроют отправления, ${fmt(round(order - forOrders))} шт. поедут на склад.`);
  if (notOrdered) parts.push(`Не заказано ${fmt(round(notOrdered))} шт. — эти отправления останутся в нехватке.`);
  if (!parts.length) { toast('Нечего оформлять'); return; }
  confirmIn(box, parts.join(' '), order ? 'Оформить закупку' : 'Списать со склада', commit);
}
