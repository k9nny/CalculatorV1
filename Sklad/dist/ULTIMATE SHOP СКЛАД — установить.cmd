const TOUR_KEY = 'sklad/tour1';
const tour = {i: 0, on: false, back: 'day', el: null, focus: null, raf: 0, steps: TOUR};
const isShown = el => el && el.getClientRects().length > 0 && !el.closest('[hidden]');
function tourStart(auto) {
  if (tour.on) return;
  Object.assign(tour, {on: true, i: 0, back: ui.tab, focus: document.activeElement, steps: EMP ? TOUR_EMP : TOUR});
  $('.shell').inert = true; $('#tour').hidden = false;
  diag('tour', auto ? 'показано при первом входе' : 'открыто кнопкой');
  tourShow();
}
function tourEnd(done) {
  if (!tour.on) return;
  tour.on = false; $('#tour').hidden = true; $('.shell').inert = false;
  lsSet(TOUR_KEY, '1');
  diag('tour', done ? 'пройдено до конца' : `закрыто на шаге ${tour.i + 1} из ${tour.steps.length}`);
  if (ui.tab !== tour.back) setTab(tour.back);
  if (tour.focus && tour.focus.focus) tour.focus.focus({preventScroll: true});
}
function tourShow() {
  const st = tour.steps[tour.i];
  if (st.tab && ui.tab !== st.tab) setTab(st.tab);
  tour.el = null;
  for (const q of st.sel || []) { const el = typeof q === 'function' ? q() : $(q); if (isShown(el)) { tour.el = el; break; } }
  $('#tourN').textContent = `Шаг ${tour.i + 1} из ${tour.steps.length}`;
  $('#tourH').textContent = st.h; $('#tourT').textContent = st.t;
  $('#tourFill').style.width = `${100 * (tour.i + 1) / tour.steps.length}%`;
  $('#tourPrev').hidden = tour.i === 0; $('#tourSkip').hidden = !!st.last;
  $('#tourNext').textContent = st.last ? 'Начать работу' : tour.i === 0 ? 'Показать' : 'Далее';
  // bring the target into view with room for the card under it, unless it sits in the fixed menu
  if (tour.el && !tour.el.closest('.side')) {
    const r = tour.el.getBoundingClientRect(), top = innerWidth < 1024 ? 76 : 20, bottom = innerWidth < 1024 ? 84 : 12;
    const free = innerHeight - top - bottom - r.height - 14 - $('#tourPop').offsetHeight;
    scrollBy({top: r.top - top - Math.max(0, free / 2), behavior: 'instant'});
  }
  tourPlace();
  $('#tourNext').focus({preventScroll: true});
}
function tourPlace() {
  const ring = $('#tourRing'), pop = $('#tourPop'), vw = innerWidth, vh = innerHeight, m = 12, gap = 14;
  const pw = pop.offsetWidth, ph = pop.offsetHeight;
  const put = (l, t) => { pop.style.left = Math.round(l) + 'px'; pop.style.top = Math.round(t) + 'px'; };
  if (!tour.el) {
    ring.classList.add('none'); Object.assign(ring.style, {left: vw / 2 + 'px', top: vh / 2 + 'px', width: '0px', height: '0px'});
    put((vw - pw) / 2, (vh - ph) / 2); return;
  }
  ring.classList.remove('none');
  const r = tour.el.getBoundingClientRect(), pad = 6;
  const x = Math.max(4, r.left - pad), y = Math.max(4, r.top - pad);
  const w = Math.min(vw - 4, r.right + pad) - x, h = Math.min(vh - 4, r.bottom + pad) - y;
  Object.assign(ring.style, {left: x + 'px', top: y + 'px', width: w + 'px', height: h + 'px'});
  const cx = l => Math.min(Math.max(m, l), vw - m - pw), cy = t => Math.min(Math.max(m, t), vh - m - ph);
  const cands = [[cx(x + w / 2 - pw / 2), y + h + gap], [cx(x + w / 2 - pw / 2), y - gap - ph], [x + w + gap, cy(y + h / 2 - ph / 2)], [x - gap - pw, cy(y + h / 2 - ph / 2)]];
  const pos = cands.find(([l, t]) => l >= m && t >= m && l + pw <= vw - m && t + ph <= vh - m);
  // a target larger than the screen: park the card where it covers the least of it
  if (pos) put(...pos); else put((vw - pw) / 2, vh - (y + h) >= y ? vh - m - ph : m);
}
function tourGo(d) {
  const j = tour.i + d;
  if (j >= tour.steps.length) { tourEnd(true); return; }
  if (j < 0) return;
  tour.i = j; tourShow();
}
$('#tourOpen').addEventListener('click', () => tourStart(false));
$('#tourNext').addEventListener('click', () => tourGo(1));
