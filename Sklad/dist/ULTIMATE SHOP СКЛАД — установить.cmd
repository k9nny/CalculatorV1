.wfoot{margin-top:auto;padding-top:12px;font-size:12.5px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.wfoot .chip{font-size:12px}
@media (max-width:520px){.w{padding:15px 15px 16px;border-radius:22px;min-height:160px}.wn{font-size:34px}.wh h3{font-size:13.5px}}
/* rings */
.rings-wrap{display:grid;grid-template-columns:minmax(150px,210px) minmax(0,1fr);gap:22px;align-items:center;flex:1}
@media (max-width:640px){.rings-wrap{grid-template-columns:minmax(0,1fr);justify-items:center}.rings{max-width:210px}}
.rings{width:100%;height:auto;overflow:visible}
.rings circle{fill:none;stroke-width:22}
.rings .rt{stroke:var(--c);opacity:.17}
.rings .rv{stroke:var(--c);stroke-linecap:round;transition:stroke-dashoffset 1.6s var(--spring-soft);filter:drop-shadow(0 0 5px color-mix(in srgb,var(--c) 55%,transparent))}
.rleg{list-style:none;margin:0;padding:0;display:grid;gap:14px;width:100%}
.rleg li{display:grid;grid-template-columns:12px minmax(0,1fr) auto;gap:4px 10px;align-items:center}
.rleg i{width:12px;height:12px;border-radius:50%;background:var(--c)}
.rleg b{font:600 14px/1.25 var(--f-ui);display:block}
.rleg span{font-size:13px;color:var(--muted);grid-column:2}
.rleg strong{grid-row:1 / span 2;grid-column:3;font:600 24px/1 ui-rounded,"SF Pro Rounded",var(--f-ui);font-variant-numeric:tabular-nums;color:var(--c)}
/* sales */
.sales-in{display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;align-items:end;flex:1}
.spark{width:100%;height:96px;overflow:visible}
.spark .ln{fill:none;stroke:var(--gold);stroke-width:2.4;stroke-linejoin:round;stroke-linecap:round}
.spark .ar{fill:url(#sparkFill)}
.spark .gl{stroke:var(--line);stroke-width:1;vector-effect:non-scaling-stroke}
.dot-live{fill:var(--gold);stroke:var(--surface);stroke-width:2.5}
.pulse{fill:var(--gold);opacity:.35;transform-box:fill-box;transform-origin:center;animation:pulse 2.2s var(--ease-out) infinite}
@keyframes pulse{from{transform:scale(1);opacity:.45}to{transform:scale(3.2);opacity:0}}
.delta{font:600 12px/1 var(--f-ui);padding:5px 8px;border-radius:999px;white-space:nowrap}
.delta.good{background:var(--good-soft);color:var(--good)}
.delta.bad{background:var(--bad-soft);color:var(--bad)}
.delta.flat{background:var(--surface-2);color:var(--muted)}
/* buy list */
.hbuy,.htop,.tips{list-style:none;margin:0;padding:0;display:grid;gap:9px}
.hbuy li{display:grid;grid-template-columns:62px minmax(0,1fr) auto 16px;gap:10px;align-items:center;font-size:13.5px}
.hbuy .pn{font:600 13px/1 var(--f-mono)}
.hbuy .tr{height:8px;border-radius:999px;background:color-mix(in srgb,var(--line) 80%,transparent);overflow:hidden}
.hbuy .fl{display:block;height:100%;border-radius:999px;background:var(--bar);transform-origin:left center}
.hbuy li:first-child .fl{background:var(--gold)}
.hbuy .q{font-weight:600;font-variant-numeric:tabular-nums;text-align:right}
.hbuy .ok{color:var(--good);width:16px;height:16px}
.hbuy .no{width:8px;height:8px;border-radius:50%;background:var(--line);justify-self:center}
.hempty{color:var(--muted);font-size:14px;margin:auto 0;display:flex;align-items:center;gap:10px}
.hbuy li.hempty,.htop li.hempty{display:flex}
.hempty .ic{color:var(--good);width:22px;height:22px}
/* sizes */
.hsizes{display:flex;align-items:flex-end;gap:8px;height:118px;margin-top:auto}
.hsizes .sb{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.hsizes .sb i{display:block;width:100%;max-width:34px;border-radius:7px 7px 3px 3px;background:var(--bar);transform-origin:50% 100%;min-height:4px}
.hsizes .sb.mx i{background:var(--gold)}
.hsizes .sb span{font:600 11.5px/1 var(--f-ui);color:var(--muted);white-space:nowrap}
.hsizes .sb.mx span{color:var(--ink)}
/* top sellers */
.htop li{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:12px;align-items:center}
.htop .ph{width:44px;height:52px;object-fit:contain;background:var(--surface-2);border-radius:10px}
.htop .nm2{font:600 13.5px/1.25 var(--f-mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.htop .sub2{font-size:12.5px;color:var(--muted)}
.htop .rt2{font:600 18px/1 ui-rounded,"SF Pro Rounded",var(--f-ui);text-align:right}
.htop .rt2 small{display:block;font:500 11.5px var(--f-ui);color:var(--muted);margin-top:3px}
/* tips */
.tips li{display:grid;grid-template-columns:10px minmax(0,1fr) auto;gap:4px 12px;align-items:center;padding:11px 12px;border-radius:14px;background:color-mix(in srgb,var(--surface-2) 85%,transparent);border:1px solid color-mix(in srgb,var(--line) 60%,transparent)}
.tips .sv{width:10px;height:10px;border-radius:50%;grid-row:1 / span 2;align-self:start;margin-top:5px}
.tips .sv.bad{background:var(--bad);box-shadow:0 0 0 4px var(--bad-soft)}
.tips .sv.warn{background:var(--warn);box-shadow:0 0 0 4px var(--warn-soft)}
.tips .sv.info{background:var(--ring2);box-shadow:0 0 0 4px color-mix(in srgb,var(--ring2) 18%,transparent)}
.tips .sv.ok{background:var(--good);box-shadow:0 0 0 4px var(--good-soft)}
.tips b{font:600 14px/1.3 var(--f-ui)}
.tips span{font-size:13px;color:var(--muted);grid-column:2}
.tips .btn{grid-row:1 / span 2;grid-column:3;min-height:36px;padding:7px 12px;font-size:13px}
@media (max-width:520px){.tips li{grid-template-columns:10px minmax(0,1fr)}.tips span{grid-row:2}.tips .btn{grid-row:3;grid-column:2;justify-self:start;margin-top:8px}}
/* Claude's brief: the Apple-Intelligence glow */
@property --ang{syntax:"<angle>";inherits:false;initial-value:0deg}
.aibtn{margin-left:auto;min-height:34px;padding:6px 12px;font-size:13px;border-color:transparent;background:linear-gradient(var(--surface),var(--surface)) padding-box,conic-gradient(from var(--ang),#F5B75F,#F26D8C,#A86BF2,#5DA8F5,#6EE7B7,#F5B75F) border-box;border:1.5px solid transparent;animation:spinAng 4s linear infinite}
.aibtn .ic{color:#B06BE0}
.ai{position:relative;border-radius:18px;padding:2px;margin-bottom:12px;background:conic-gradient(from var(--ang),#F5B75F,#F26D8C,#A86BF2,#5DA8F5,#6EE7B7,#F5B75F);animation:spinAng 2.6s linear infinite}
.ai::after{content:"";position:absolute;inset:-4px;border-radius:22px;background:inherit;filter:blur(14px);opacity:.5;z-index:-1;transition:opacity .6s}
.ai.done{animation-duration:10s}
.ai.done::after{opacity:.18}
.ai-in{background:var(--surface);border-radius:16px;padding:12px 14px 14px}
.ai-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
.ai-lbl{font:600 11.5px/1 var(--f-ui);letter-spacing:.12em;text-transform:uppercase;background:linear-gradient(90deg,#E08A3C,#D9577E,#7B5BE6);-webkit-background-clip:text;background-clip:text;color:transparent}
.ai-text{font-size:14.5px;line-height:1.55;white-space:pre-wrap;min-height:1.5em}
.ai-text.think{background:linear-gradient(90deg,var(--muted) 30%,var(--ink) 50%,var(--muted) 70%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmer 1.6s linear infinite}
@keyframes shimmer{from{background-position:120% 0}to{background-position:-120% 0}}
@keyframes spinAng{to{--ang:360deg}}
.helpbtn.gear{display:none}
@media (max-width:1023px){#t-settings{display:none}.helpbtn.gear{display:grid;place-items:center}.side .tab{flex:1 0 54px;font-size:10.5px}.side .tab .tl{max-width:100%;overflow:hidden;text-overflow:ellipsis}}
@media (prefers-reduced-motion:reduce){.aurora i,.pulse,.ai,.aibtn,.ai-text.think{animation:none!important}.rings .rv,.w{transition:none!important}}

/* ============ photo viewer ============ */
img.ph.zoom{cursor:zoom-in;transition:transform .45s var(--spring),box-shadow .25s}
@media (hover:hover){img.ph.zoom:hover{transform:scale(1.06);box-shadow:0 8px 20px -10px rgba(0,0,0,.45)}}
img.ph.zoom:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.lb{position:fixed;inset:0;z-index:92;display:grid;grid-template-columns:64px minmax(0,1fr) 64px;align-items:center;background:rgba(8,9,11,.88);-webkit-backdrop-filter:blur(18px) saturate(1.2);backdrop-filter:blur(18px) saturate(1.2);padding:calc(env(safe-area-inset-top,0px) + 12px) 8px calc(env(safe-area-inset-bottom,0px) + 12px);color:#F4F4F6;animation:fadeIn .25s ease-out}
.lb-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,340px);gap:28px;align-items:center;justify-items:center;max-height:100%;min-width:0}
.lb-imgw{display:grid;place-items:center;width:100%;height:min(82vh,760px);min-width:0}
.lb-imgw img{max-width:100%;max-height:100%;border-radius:18px;background:#fff;box-shadow:0 30px 80px -20px rgba(0,0,0,.7);touch-action:pan-y}
.lb-cap{justify-self:stretch;display:grid;gap:10px;align-content:center}
.lb-t{font:600 22px/1.2 var(--f-mono);word-break:break-word}
.lb-n{font-size:15px;color:#B9BDC4;line-height:1.45}
.lb-sz{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.lb-sz .z{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:9px 12px;display:grid;gap:2px;min-width:78px}
.lb-sz .z b{font:600 20px/1 var(--f-ui)}
.lb-sz .z span{font-size:12.5px;color:#B9BDC4}
.lb-sz .z.ok{border-color:rgba(95,203,145,.55);background:rgba(95,203,145,.12)}
.lb-sz button.z{appearance:none;color:inherit;font:inherit;text-align:left;cursor:pointer;transition:transform .4s var(--spring),background-color .2s}
.lb-sz button.z:active{transform:scale(.94)}
.lb-sz .z i{font-style:normal;font:600 12px var(--f-ui);color:#D9B76E}
.lb-pos{font-size:12.5px;color:#8E939C}
.lb-x{position:absolute;top:calc(env(safe-area-inset-top,0px) + 12px);right:14px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(255,255,255,.1);color:#fff;font:400 26px/1 var(--f-ui);cursor:pointer;z-index:2;transition:transform .45s var(--spring),background-color .2s}
.lb-x:hover{background:rgba(255,255,255,.18);transform:rotate(90deg)}
.lb-nav{width:52px;height:52px;border-radius:50%;border:0;background:rgba(255,255,255,.1);color:#fff;cursor:pointer;display:grid;place-items:center;justify-self:center;transition:transform .45s var(--spring),background-color .2s,opacity .2s}
.lb-nav svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.lb-nav:hover{background:rgba(255,255,255,.2);transform:scale(1.08)}
.lb-nav:disabled{opacity:0;pointer-events:none}
.lb button:focus-visible{outline:3px solid #80A8FF;outline-offset:2px}
@media (max-width:760px){
  .lb{grid-template-columns:minmax(0,1fr);align-content:center;padding-inline:14px}
  .lb-fig{grid-template-columns:minmax(0,1fr);gap:16px}
  .lb-imgw{height:min(56vh,520px)}
  .lb-cap{justify-self:stretch}
  .lb-t{font-size:18px}
  .lb-nav{position:absolute;bottom:calc(env(safe-area-inset-bottom,0px) + 16px);width:48px;height:48px}
  .lb-nav.prev{left:16px}.lb-nav.next{right:16px}
  .lb-pos{text-align:center}
}
@media (prefers-reduced-motion:reduce){.lb{animation:none}img.ph.zoom,.lb-x,.lb-nav,.lb-sz button.z{transition:none}}

/* ============ «Где шуба?» ============ */
.top .title{order:0}.gs{order:1}.top .kpis{order:2}
.gs{position:relative;flex:1 1 260px;max-width:400px;align-self:center;z-index:40}
.gsf{display:flex;align-items:center;gap:10px;height:46px;padding:0 12px 0 14px;border-radius:14px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);cursor:text;transition:border-color .2s,box-shadow .3s var(--ease-out)}
.gsf:focus-within{border-color:var(--ink);box-shadow:0 0 0 4px color-mix(in srgb,var(--gold) 22%,transparent),var(--shadow)}
.gsf .ic{color:var(--muted);width:18px;height:18px}
.gsf input{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font:500 15px var(--f-ui);outline:none;height:100%}
.gsf input::-webkit-search-cancel-button{cursor:pointer}
.gsf kbd{font:600 11px/1 var(--f-mono);color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:4px 7px;background:var(--surface-2)}
.gsf:focus-within kbd{display:none}
.gres{position:absolute;top:calc(100% + 10px);right:0;width:min(620px,calc(100vw - 32px));max-height:min(70vh,640px);overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:0 30px 70px -24px rgba(0,0,0,.45);padding:10px;display:grid;gap:8px;animation:gresIn .45s var(--spring)}
@keyframes gresIn{from{opacity:0;transform:translateY(-8px) scale(.98)}to{opacity:1;transform:none}}
.gr{display:grid;gap:10px;padding:12px;border-radius:14px;background:var(--surface-2)}
.gh{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;align-items:center}
.gh .ph{width:48px;height:58px}
.gh b{display:block;font:600 15px/1.25 var(--f-mono);word-break:break-word}
.gh .nm{display:block;font-size:13px;color:var(--muted);margin-top:2px}
.gl{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.gl li{display:grid;grid-template-columns:22px 118px minmax(0,1fr);gap:8px;align-items:baseline;font-size:13.5px}
.gl li .ic{width:16px;height:16px;color:var(--muted);align-self:center}
.gl li b{font-weight:600;color:var(--muted)}
.gl li span{color:var(--ink)}
.gl li.none span{color:var(--muted)}
.gl .st{display:inline-flex;gap:6px;flex-wrap:wrap}
.ga{display:flex;gap:6px;flex-wrap:wrap}
.ga .btn{min-height:34px;padding:6px 12px;font-size:13px}
.gempty{padding:18px;text-align:center;color:var(--muted);font-size:14px}
body.emp [data-gs-go="day"],body.emp [data-gs-go="buy"]{display:none}
@media (max-width:1023px){.gs{order:3;flex-basis:100%;max-width:none}.gres{left:0;right:auto;width:100%}.gsf kbd{display:none}.gl li{grid-template-columns:20px 100px minmax(0,1fr)}}
@media (prefers-reduced-motion:reduce){.gres{animation:none}}

/* undo in the island */
.toast .tu{appearance:none;border:0;margin-left:4px;background:rgba(255,255,255,.14);color:#fff;font:600 13.5px/1 var(--f-ui);border-radius:999px;padding:7px 13px 7px 8px;display:inline-flex;align-items:center;gap:7px;cursor:pointer;white-space:nowrap;transition:background-color .2s,transform .4s var(--spring)}
.toast .tu:hover{background:rgba(255,255,255,.24)}
.toast .tu:active{transform:scale(.94)}
.toast .tu svg{width:18px;height:18px;transform:rotate(-90deg)}
.toast .tu circle{fill:none;stroke:#D9B76E;stroke-width:2.4;stroke-linecap:round;stroke-dasharray:44;stroke-dashoffset:0;animation:undoRing linear forwards}
@keyframes undoRing{to{stroke-dashoffset:44}}
@media (prefers-reduced-motion:reduce){.toast .tu circle{animation:none}}

/* ============ employee mode ============ */
.empbadge,.helpbtn.empexit,.onlyemp{display:none}
