$('#tourSkip').addEventListener('click', () => tourEnd(false));
document.addEventListener('keydown', e => {
  if (!tour.on) return;
  if (e.key === 'Escape') tourEnd(false);
  else if (e.key === 'ArrowRight') tourGo(1);
  else if (e.key === 'ArrowLeft') tourGo(-1);
  else if (e.key === 'Tab') { const b = [...$$('#tourPop .btn')].filter(x => !x.hidden); const k = b.indexOf(document.activeElement); e.preventDefault(); b[(k + (e.shiftKey ? -1 : 1) + b.length) % b.length].focus(); }
  else return;
  e.preventDefault(); e.stopImmediatePropagation();
}, true);
const tourReplace = () => { if (!tour.on) return; cancelAnimationFrame(tour.raf); tour.raf = requestAnimationFrame(tourPlace); };
addEventListener('resize', tourReplace); addEventListener('scroll', tourReplace, {passive: true});

