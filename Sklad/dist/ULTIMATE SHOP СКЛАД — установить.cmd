          <div class="sales-in">
            <div><div class="wn"><span data-roll id="hSalesQ">0</span><small>шт.</small></div><div class="wsub" id="hSalesS">за 7 дней</div></div>
            <svg class="spark" id="hSpark" viewBox="0 0 300 96" role="img" aria-label="Продажи за 14 дней"></svg>
          </div>
