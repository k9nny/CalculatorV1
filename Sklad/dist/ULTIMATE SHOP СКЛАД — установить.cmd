  let t = String(raw ?? '').normalize('NFKC')
    .replace(/[​-‍⁠﻿]/g, '')
    .replace(/[  -   　]/g, ' ')
    .replace(/[‐-―−]/g, '-')
    .trim().toUpperCase();
  if (s.latin) t = t.replace(/[АВЕЁКМНОРСТУХ]/g, c => CYR[c]);
