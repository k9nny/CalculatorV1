# Скопируйте в .env и заполните. Файл .env не попадает в репозиторий.
# Запуск с файлом настроек: node --env-file=.env server/server.js

PORT=8080

# Токен Telegram-бота от @BotFather: проверка заявок из Telegram и отправка их менеджерам.
TELEGRAM_BOT_TOKEN=

# Токен бота MAX: проверка заявок из MAX.
MAX_BOT_TOKEN=

# Куда присылать заявки: id чатов в Telegram через запятую (менеджер, общий чат).
# Свой id можно узнать у бота @userinfobot; менеджер должен один раз написать боту /start.
MANAGER_CHAT_IDS=

# Кто может добавлять машины через бота: id в Telegram через запятую (Владимир, Андрей).
ADMIN_IDS=

# Ссылка на мини-приложение (https://t.me/<бот>/<приложение>) — бот дописывает её к опубликованным машинам.
APP_LINK=

# 1 — принимать заявки только из Telegram и MAX с проверенной подписью (без сайта).
REQUIRE_INIT_DATA=0

# 1 — сервер стоит за nginx или Caddy: адрес клиента брать из X-Forwarded-For.
TRUST_PROXY=0

# Если приложение и сервер на разных адресах: адреса приложения через запятую.
ALLOWED_ORIGINS=

# Журнал заявок (по умолчанию data-private/leads.jsonl).
LEADS_LOG=
