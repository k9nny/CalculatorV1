    <!-- ДЕНЬ -->
    <section class="pane stack" id="pane-day" role="tabpanel" aria-labelledby="t-day">
      <div class="card">
        <h2>Лист подбора</h2>
        <p class="hint">Загрузите лист подбора Озона (PDF) или выгрузку отправлений из Excel. Товар со склада достаётся сначала отправлениям с прошлых дней, потом новым. Отправления, которые уже есть в программе, не задвоятся.</p>
        <div class="row mt">
          <button class="btn primary" type="button" data-import="orders"><svg class="ic"><use href="#i-up"/></svg>Загрузить лист подбора</button>
          <button class="btn" type="button" data-paste="orders">Вставить из Excel</button>
        </div>
        <div class="ometa" id="dayMeta"></div>
        <div class="ometa" id="photoStatus" hidden></div>
      </div>
      <ol class="steps" id="dayEmpty">
        <li><b>Загрузите лист подбора</b>Программа отдаст товар со склада и покажет, чего не хватает.</li>
        <li><b>Оформите закупку</b>На вкладке «Закупка» впишите, сколько берёте, хоть целый мешок. Товар со склада в этот момент спишется под отправления.</li>
        <li><b>Примите мешок</b>На вкладке «Приёмка» посчитайте, что приехало. Товар разложится по отправлениям, остаток уйдёт на склад.</li>
      </ol>
      <div class="tiles four" id="dayTiles" hidden>
        <div class="tile"><span class="k">В работе</span><span class="v" id="tAll">0</span><span class="s" id="tAllS"></span></div>
        <div class="tile"><span class="k">Можно собирать</span><span class="v" id="tPick">0</span><span class="s" id="tPickS"></span></div>
        <div class="tile"><span class="k">Ждут мешок</span><span class="v" id="tWait">0</span><span class="s" id="tWaitS"></span></div>
        <div class="tile hot"><span class="k">Не хватает</span><span class="v" id="tShort">0</span><span class="s" id="tShortS"></span></div>
      </div>
      <div class="card daybar" id="dayBar" hidden>
        <div class="segbar" id="segbar" role="img"></div>
        <div class="segleg" id="segleg"></div>
      </div>
      <div class="notice" id="dayPending" hidden></div>
      <div class="card" id="dayCard" hidden>
        <div class="lhead">
          <div class="seg" role="group" aria-label="Фильтр отправлений" id="daySeg">
            <button type="button" data-f="all" aria-pressed="true">Все</button>
            <button type="button" data-f="pick" aria-pressed="false">Собирать</button>
            <button type="button" data-f="wait" aria-pressed="false">Ждут мешок</button>
            <button type="button" data-f="short" aria-pressed="false">Не хватает</button>
          </div>
          <input class="in search" id="daySearch" type="search" placeholder="Отправление или артикул" aria-label="Поиск по отправлениям">
        </div>
        <div class="tw">
          <table class="t">
            <thead><tr><th>Отправление</th><th>Товар</th><th class="num">Шт.</th><th>Статус</th><th><span hidden>Убрать</span></th></tr></thead>
            <tbody id="dayBody"></tbody>
          </table>
        </div>
        <button class="btn ghost more" id="dayMore" type="button" hidden>Показать ещё</button>
        <div class="actions">
          <button class="btn" type="button" id="dayExport"><svg class="ic"><use href="#i-dl"/></svg>Скачать статусы отправлений (Excel)</button>
          <button class="btn ghost danger" type="button" id="dayClear">Убрать все отправления</button>
        </div>
        <div class="confirm" id="dayConfirm" hidden></div>
      </div>
    </section>

    <!-- ЗАКУПКА -->
    <section class="pane stack" id="pane-buy" role="tabpanel" aria-labelledby="t-buy" hidden>
      <div class="card">
        <div class="lhead"><h2 id="buyTitle">Закупка</h2><span class="sum" id="buySum"></span></div>
        <p class="hint">Здесь всё, чего не хватает под отправления, по павильонам. В поле «Заказать» можно вписать больше, на целый мешок: лишнее поедет на склад. Когда заказали у поставщиков, нажмите «Оформить закупку».</p>
        <form class="addrow" id="addForm" autocomplete="off">
          <label class="fld">Добавить артикул в закупку<input class="in mono" id="addArt" placeholder="например, A04-LM9-Ser-1900-46" spellcheck="false"></label>
          <label class="fld">Шт.<input class="in" id="addQty" inputmode="decimal" value="1"></label>
          <button class="btn" type="submit">Добавить</button>
        </form>
        <div class="actions">
          <button class="btn primary" type="button" id="buyCommit">Оформить закупку</button>
          <button class="btn" type="button" id="buyPdfAll"><svg class="ic"><use href="#i-doc"/></svg>Все заказы с фото (PDF)</button>
          <button class="btn" type="button" id="buyExport"><svg class="ic"><use href="#i-dl"/></svg>Скачать Excel</button>
        </div>
        <div class="confirm" id="buyConfirm" hidden></div>
      </div>
      <div class="card twbar" id="twBar" hidden></div>
      <div class="card pavpick" id="pavPick" hidden>
        <div class="lhead"><h3>Павильоны</h3><span class="sum" id="ppSum"></span></div>
        <div class="pp-nav"><button class="btn ico" type="button" data-pav-step="-1" aria-label="Предыдущий павильон">←</button><select class="in" id="ppSel" aria-label="Павильон"></select><button class="btn ico" type="button" data-pav-step="1" aria-label="Следующий павильон">→</button></div>
        <div class="ppchips" id="ppChips" role="group" aria-label="Выбор павильона"></div>
      </div>
      <div class="card skipbar" id="skipBar" hidden></div>
      <div class="stack" id="buyList"></div>
      <div class="card">
        <h3>Едут от поставщиков</h3>
        <div class="golist mt" id="goList"></div>
        <div class="confirm" id="goConfirm" hidden></div>
      </div>
    </section>

    <!-- ПРИЁМКА -->
    <section class="pane stack" id="pane-recv" role="tabpanel" aria-labelledby="t-recv" hidden>
      <div class="stack" id="recvHome">
        <div class="card">
          <h2>Приёмка мешков</h2>
          <p class="hint">Выберите закупку, которая приехала, и посчитайте, что пришло на самом деле. Программа сравнит это с заказом, разложит товар по отправлениям, а остаток отправит на склад.</p>
          <div class="golist mt" id="recvGo"></div>
          <div class="confirm" id="recvGoConfirm" hidden></div>
        </div>
        <div class="card"><h3>Недавние приёмки</h3><div class="mt" id="recvHist"></div></div>
      </div>
      <div class="stack" id="recvView" hidden>
        <div class="card">
          <button class="btn ghost" type="button" id="recvBack">← Все закупки</button>
          <h2 id="recvTitle" style="margin-top:8px"></h2>
          <p class="hint" id="recvSub"></p>
          <div class="track"><div class="fill" id="recvFill"></div></div>
          <input class="in search mt" id="recvSearch" type="search" placeholder="Найти модель или размер" aria-label="Найти модель">
        </div>
        <div class="stack" id="recvModels"></div>
        <div class="card">
          <h3>Не из заказа</h3>
          <p class="hint">Шуба, которой нет в списке выше. Впишите артикул с бирки и выберите, что с ней делать.</p>
          <form class="addrow ex" id="exForm" autocomplete="off">
            <label class="fld">Артикул<input class="in mono" id="exArt" list="artList" spellcheck="false"></label>
            <label class="fld">Шт.<input class="in" id="exQty" inputmode="decimal" value="1"></label>
            <label class="fld">Куда<select class="in" id="exTo"><option value="stock">На склад</option><option value="ret">Вернуть поставщику</option></select></label>
            <button class="btn" type="submit">Добавить</button>
          </form>
          <div class="mt" id="recvExtras"></div>
        </div>
        <div class="card sticky-actions">
          <div class="sum" id="recvCount"></div>
          <div class="actions" style="margin-top:10px">
            <button class="btn primary" type="button" id="recvFinish">Провести приёмку</button>
            <button class="btn" type="button" id="recvAsIs">Принять как заявлено</button>
          </div>
          <div class="confirm" id="recvConfirm" hidden></div>
        </div>
        <datalist id="artList"></datalist>
      </div>
    </section>

    <!-- СКЛАД -->
    <section class="pane stack" id="pane-stock" role="tabpanel" aria-labelledby="t-stock" hidden>
      <div class="card">
        <div class="lhead">
          <h2>Остатки на складе</h2>
          <span class="sum" id="stSum"></span>
          <input class="in search" id="stSearch" type="search" placeholder="Поиск по артикулу или названию" aria-label="Поиск по складу">
        </div>
        <div class="row" style="margin-bottom:12px">
          <div class="seg" role="group" aria-label="Вид" id="stSeg">
            <button type="button" data-v="models" aria-pressed="true">По моделям</button>
            <button type="button" data-v="flat" aria-pressed="false">По артикулам</button>
          </div>
          <select class="in sortsel" id="stPav" aria-label="Павильон"></select>
          <select class="in sortsel" id="stSort" aria-label="Сортировка">
            <option value="pav">По павильонам</option>
            <option value="old">Дольше всего без продаж</option>
            <option value="big">Больше всего штук</option>
          </select>
        </div>
        <div id="stModels"></div>
        <div class="tw" id="stFlat" hidden>
          <table class="t">
            <thead><tr><th>Товар</th><th class="num">Остаток, шт.</th><th><span hidden>Удалить</span></th></tr></thead>
            <tbody id="stBody"></tbody>
          </table>
        </div>
        <button class="btn ghost more" id="stMore" type="button" hidden>Показать ещё</button>
        <p class="hint small" id="stLegend"></p>
        <div class="row mt">
          <button class="btn" type="button" data-import="stock">Загрузить остатки из файла</button>
          <button class="btn" type="button" data-paste="stock">Вставить из Excel</button>
          <button class="btn" type="button" data-export-stock><svg class="ic"><use href="#i-dl"/></svg>Скачать остатки (Excel)</button>
        </div>
        <div class="confirm" id="stConfirm" hidden></div>
      </div>

      <div class="card">
        <h2>Пересчёт и ручной приход</h2>
        <p class="hint">Введите артикул и количество или просканируйте штрихкод. Одинаковые артикулы складываются. Потом <span class="noemp">добавьте список на склад или замените им весь склад, если это полный пересчёт.</span><span class="onlyemp">нажмите «Добавить на склад».</span></p>
        <form class="scan" id="scanForm" autocomplete="off">
          <label class="fld">Артикул или штрихкод<input class="in big" id="scanArt" spellcheck="false" autocapitalize="characters" enterkeyhint="done"></label>
          <label class="fld">Кол-во, шт.<input class="in big" id="scanQty" inputmode="decimal" value="1"></label>
          <button class="btn primary" type="submit">Добавить</button>
        </form>
        <div class="scaninfo" id="scanInfo" aria-live="polite"></div>
        <div class="row mt">
          <button class="btn" type="button" data-import="receipt">Загрузить из файла</button>
          <button class="btn" type="button" data-paste="receipt">Вставить из Excel</button>
        </div>
        <div class="lhead mt">
          <h3>Список</h3>
          <span class="sum" id="rcSum"></span>
          <input class="in search" id="rcSearch" type="search" placeholder="Поиск в списке" aria-label="Поиск в списке пересчёта">
        </div>
        <div class="tw">
          <table class="t">
            <thead><tr><th>Товар</th><th class="num">Сейчас на складе</th><th class="num">Посчитано</th><th><span hidden>Удалить</span></th></tr></thead>
            <tbody id="rcBody"></tbody>
          </table>
        </div>
        <button class="btn ghost more" id="rcMore" type="button" hidden>Показать ещё</button>
        <div class="actions">
          <button class="btn primary" id="rcAdd" type="button">Добавить на склад</button>
          <button class="btn" id="rcReplace" type="button">Это полный пересчёт — заменить склад</button>
          <button class="btn ghost danger" id="rcClear" type="button">Очистить список</button>
        </div>
        <div class="confirm" id="rcConfirm" hidden></div>
      </div>

      <div class="card">
        <div class="lhead"><h3>Вернуть поставщикам</h3><span class="sum" id="retSum"></span></div>
        <div id="retList"></div>
        <button class="btn mt" type="button" id="retCopy" hidden>Скопировать список</button>
      </div>

      <div class="card">
        <h3>Журнал операций</h3>
        <ol class="log" id="log"></ol>
      </div>
    </section>

    <!-- АНАЛИЗ -->
    <section class="pane stack" id="pane-an" role="tabpanel" aria-labelledby="t-an" hidden>
      <div class="card">
        <div class="lhead"><h2>Анализ продаж</h2><span class="sum" id="anCover"></span></div>
        <p class="hint">Продажи считаются по загруженным листам подбора и по выгрузке заказов из Озона. Отсюда подсказки: что закупить впрок, что залежалось, где поменять цену.</p>
        <form class="anparams mt" id="anForm" autocomplete="off">
          <label class="fld">Закупать впрок на, дней<input class="in" id="anDays" inputmode="numeric"></label>
          <label class="fld">Мешок едет, дней<input class="in" id="anLead" inputmode="numeric"></label>
          <label class="fld">Считать продажи за, дней<input class="in" id="anWin" inputmode="numeric"></label>
          <label class="fld">Залежалось после, дней<input class="in" id="anDead" inputmode="numeric"></label>
        </form>
        <div class="row mt">
          <button class="btn" type="button" data-import="history">Загрузить историю продаж из Озона</button>
          <button class="btn ghost" type="button" id="anReload">Пересчитать</button>
        </div>
      </div>
      <div class="card" id="anEmpty" hidden>
        <h3>Пока нет истории продаж</h3>
        <p class="hint">Её можно набрать двумя способами: каждый день загружать лист подбора на вкладке «Заказы» (история копится сама) или сразу загрузить выгрузку заказов из кабинета Озона за 1–3 месяца кнопкой выше. Нужны колонки с датой заказа, артикулом и количеством; колонка статуса поможет не считать отменённые заказы.</p>
      </div>
      <div class="tiles four" id="anTiles">
        <div class="tile"><span class="k">Продаётся в день</span><span class="v" id="aSale">0</span><span class="s" id="aSaleS"></span></div>
        <div class="tile"><span class="k">На складе</span><span class="v" id="aStock">0</span><span class="s" id="aStockS"></span></div>
        <div class="tile"><span class="k">Залежалось</span><span class="v" id="aDead">0</span><span class="s" id="aDeadS"></span></div>
        <div class="tile hot"><span class="k">Закупить впрок</span><span class="v" id="aBuy">0</span><span class="s" id="aBuyS"></span></div>
      </div>
      <div class="card">
        <div class="lhead"><h3>Продажи по дням</h3><span class="sum" id="chartSum"></span></div>
        <div class="chart" id="salesChart"></div>
        <details class="small mt" id="chartTable"><summary>Таблица по дням</summary><div class="tw mt"><table class="t"><thead><tr><th>День</th><th class="num">Продано, шт.</th></tr></thead><tbody id="chartRows"></tbody></table></div></details>
      </div>
      <div class="card">
        <div class="lhead"><h3>Закупить впрок</h3><span class="sum" id="anBuySum"></span><button class="btn primary" type="button" id="anBuyAll">Добавить всё в закупку</button></div>
        <p class="hint small" style="margin:0 0 10px">Сколько взять сверх сегодняшних заказов, чтобы товар был на складе на выбранное число дней и заказы собирались день в день. Считается по продажам в день минус то, что уже лежит и едет.</p>
        <div id="anBuy"></div>
      </div>
      <div class="card">
        <div class="lhead"><h3>Залежалось — стоит снизить цену</h3><span class="sum" id="anDeadSum"></span></div>
        <div id="anDeadList"></div>
      </div>
      <div class="card">
        <div class="lhead"><h3>Продаётся хорошо, а на складе нет — можно поднять цену</h3></div>
        <div id="anHot"></div>
      </div>
      <div class="card">
        <h3>Размеры на складе</h3>
        <p class="hint small" style="margin:6px 0 10px">На сколько дней хватит каждого размера при нынешних продажах. Так видно перекос: например, 40-го лежит на полгода, а 44-го на день.</p>
        <div class="tw"><table class="t"><thead><tr><th>Размер</th><th class="num">На складе</th><th class="num">Продаётся в день</th><th class="num">Хватит на</th><th></th></tr></thead><tbody id="anSizes"></tbody></table></div>
      </div>
      <div class="card">
        <h3>Поставщики: насколько точно привозят</h3>
        <div class="tw mt"><table class="t"><thead><tr><th>Павильон</th><th class="num">Приёмок</th><th class="num">Заказано</th><th class="num">Пришло</th><th class="num">Не доложили</th><th class="num">Лишнее и чужое</th></tr></thead><tbody id="anSup"></tbody></table></div>
      </div>
    </section>

    <!-- НАСТРОЙКИ -->
    <section class="pane stack" id="pane-settings" role="tabpanel" aria-labelledby="t-settings" hidden>
      <div class="card empcard">
        <h2>Режим сотрудника</h2>
        <p class="hint">Для телефона приёмщика. На этом устройстве останутся только «Приёмка» и «Склад», без денег, закупки, анализа и настроек. Спрячутся и кнопки, которыми можно испортить склад: замена склада, загрузка файлов, правка остатков. На других устройствах ничего не изменится.</p>
        <form class="addrow" id="empForm" autocomplete="off">
          <label class="fld">Код для выхода, если нужен<input class="in" id="empPin" inputmode="numeric" maxlength="6" placeholder="например, 2580" autocomplete="off"></label>
          <button class="btn primary" type="submit">Включить на этом устройстве</button>
        </form>
        <p class="hint small">Без кода выйти сможет любой, кто нажмёт «Выйти из режима сотрудника». С кодом выход только по нему.</p>
      </div>
      <div class="card">
        <h2>Как читать артикул</h2>
        <label class="opt"><input type="checkbox" id="optPrice"><div><b>Число в артикуле — закупочная цена</b><span>В <code class="k">A04-LM9-Ser-1900-3XL</code> цена — <code class="k">1900</code>. По ней программа считает, сколько денег нужно на закупку, сколько стоит склад и сколько денег лежит в залежавшемся товаре. Если число означает что-то другое, выключите.</span></div></label>
        <label class="opt"><input type="checkbox" id="optPav"><div><b>Первая часть артикула — павильон</b><span>В <code class="k">A04-LM9-Ser-1900-3XL</code> павильон — <code class="k">A04</code>. По нему закупка делится на части. Последняя часть, если это размер (<code class="k">42</code>, <code class="k">3XL</code>), всегда считается размером.</span></div></label>
      </div>
      <div class="card">
        <h2>Размеры: буквы и цифры</h2>
        <p class="hint">Один магазин пишет размер буквой, другой цифрой. По этой таблице программа считает их одним размером: заказы и остатки складываются, а в закупке, приёмке и заказе поставщику видны оба названия, например «M/44».</p>
        <label class="fld mt" style="max-width:560px">Таблица размеров<input class="in mono" id="optSizes" spellcheck="false" autocomplete="off"></label>
        <p class="hint small">Через запятую: буква=цифра. XXL и 2XL, XXXL и 3XL — одно и то же. Если очистить поле, буквы и цифры снова будут разными размерами.</p>
      </div>
      <div class="card">
        <h2>Как сравнивать артикулы</h2>
        <p class="hint">Один и тот же товар в разных файлах бывает записан по-разному. Эти правила помогают понять, что это один артикул. Большие и маленькие буквы не различаются никогда.</p>
        <label class="opt"><input type="checkbox" id="optLatin"><div><b>Русские и английские буквы — одно и то же</b><span>Похожие буквы <code class="k">А В Е К М Н О Р С Т У Х</code> считаются одинаковыми: <code class="k">АВ-12</code> на русском = <code class="k">AB-12</code> на английском.</span></div></label>
        <label class="opt"><input type="checkbox" id="optZeros"><div><b>Не учитывать нули в начале</b><span>Excel часто убирает нули: <code class="k">00123</code> превращается в <code class="k">123</code>. С этим правилом они совпадут.</span></div></label>
        <label class="opt"><input type="checkbox" id="optPunct"><div><b>Не учитывать пробелы, дефисы, точки и слэши</b><span><code class="k">AB-123</code>, <code class="k">AB 123</code> и <code class="k">AB123</code> — один артикул.</span></div></label>
        <p class="hint small">Если включить правило, совпавшие по нему артикулы на складе объединятся и их количество сложится. Выключение правила обратно их не разделит.</p>
        <div class="tester">
          <label class="fld">Проверить артикул<input class="in mono" id="testIn" placeholder="например, 00АВ-123" spellcheck="false"></label>
          <div class="fld">Программа видит его как<div class="keyout" id="testOut">—</div></div>
        </div>
        <p class="hint" id="testMatch"></p>
      </div>
      <div class="card">
        <h2>Товары двух магазинов</h2>
        <p class="hint">Одна и та же шуба в двух магазинах бывает под разными артикулами. Объединённые артикулы программа считает одним товаром: заказы складываются в одну строку закупки, остаток на складе общий.</p>
        <div class="row mt" style="gap:12px;align-items:center"><span class="sum" id="twSetSum"></span><button class="btn" type="button" data-twin="*"><svg class="ic"><use href="#i-link"/></svg>Одинаковые товары</button></div>
        <h3 class="mt">Модели в другом павильоне</h3>
        <p class="hint small">Сюда попадает модель после кнопки «Перенести» на вкладке «Закупка».</p>
        <div id="mvList"></div>
      </div>
      <div class="card">
        <h2>Поставщик</h2>
        <p class="hint">Где вы докупаете товар. Название попадёт в заголовок и имя файла закупки.</p>
        <label class="fld mt" style="max-width:420px">Поставщик<input class="in" id="optSupplier"></label>
      </div>
      <div class="card">
        <h2>Поставщики в WhatsApp</h2>
        <p class="hint">У каждого павильона свой поставщик. Впишите имя и номер WhatsApp: тогда на вкладке «Закупка» у павильона появится кнопка «WhatsApp» — она откроет чат с этим поставщиком, где уже вписан его заказ.</p>
        <div class="tw mt"><table class="suptab"><thead><tr><th>Павильон</th><th>Поставщик</th><th>WhatsApp</th><th></th></tr></thead><tbody id="supList"></tbody></table></div>
        <form class="addrow ex" id="supAdd" autocomplete="off" style="grid-template-columns:120px 1fr 1fr auto">
          <label class="fld">Павильон<input class="in mono" id="supPav" placeholder="A04"></label>
          <label class="fld">Поставщик<input class="in" id="supName" placeholder="имя"></label>
          <label class="fld">WhatsApp<input class="in" id="supPhone" type="tel" inputmode="tel" placeholder="+7 900 000-00-00"></label>
          <button class="btn" type="submit">Добавить</button>
        </form>
      </div>
      <div class="card">
        <h2>Служебный журнал</h2>
        <p class="hint">Технические записи для Claude: ошибки, загрузки файлов, проведённые операции, скорость работы и устройство. Claude читает их сам, когда вы просите разобраться, что происходит. Здесь последние записи с этого устройства.</p>
        <ol class="log" id="diagList"></ol>
        <button class="btn mt" type="button" id="diagCopy">Скопировать журнал</button>
      </div>
      <div class="card">
        <h2>Данные</h2>
        <p class="hint" id="storeNote"></p>
        <div class="row mt">
          <button class="btn" type="button" data-export-stock><svg class="ic"><use href="#i-dl"/></svg>Скачать остатки (Excel)</button>
          <button class="btn" type="button" id="bkSave"><svg class="ic"><use href="#i-dl"/></svg>Скачать резервную копию</button>
          <button class="btn" type="button" id="bkLoad">Восстановить из копии</button>
          <button class="btn danger" type="button" id="stClear">Очистить склад</button>
        </div>
        <input type="file" id="bkFile" accept=".json,application/json" hidden>
        <div class="confirm" id="setConfirm" hidden></div>
      </div>
    </section>
  </main>
</div>
</div>

<input type="file" id="fileIn" multiple accept=".pdf,.xlsx,.xls,.xlsm,.xlsb,.ods,.csv,.txt,.tsv" hidden>

<div class="modal" id="imp" role="dialog" aria-modal="true" aria-labelledby="impTitle" hidden>
  <div class="sheet">
    <header><h2 id="impTitle">Загрузка</h2><button class="x" type="button" id="impX" aria-label="Закрыть">×</button></header>
    <div class="sbody">
      <div id="impPasteBox" hidden>
        <label class="fld">Скопируйте в Excel нужные строки вместе с заголовками и вставьте сюда (Ctrl+V)
          <textarea class="in paste" id="impText" spellcheck="false"></textarea>
        </label>
      </div>
      <div id="impMapBox" class="stack" hidden>
        <div id="impFiles" class="small"></div>
        <div class="mapgrid">
          <label class="fld" id="impSheetF">Лист<select class="in" id="impSheet"></select></label>
          <label class="fld">Строка с заголовками<select class="in" id="impHeader"></select></label>
          <label class="fld">Колонка «Артикул»<select class="in" id="impArt"></select></label>
          <label class="fld">Колонка «Количество»<select class="in" id="impQty"></select></label>
          <label class="fld">Колонка «Наименование»<select class="in" id="impName"></select></label>
          <label class="fld" id="impShipF">Колонка «Номер отправления»<select class="in" id="impShip"></select></label>
          <label class="fld" id="impDateF">Колонка «Дата заказа»<select class="in" id="impDate"></select></label>
          <label class="fld" id="impStatF">Колонка «Статус»<select class="in" id="impStat"></select></label>
        </div>
        <p class="hint small" style="margin:0">Ниже первые строки файла — только чтобы проверить, правильно ли найдены колонки. Загрузятся все строки.</p>
        <div class="tw prev"><table class="t" id="impPrev"></table></div>
        <div class="stats" id="impStats"></div>
        <fieldset class="modes" id="impModes"></fieldset>
      </div>
    </div>
    <footer>
      <button class="btn" type="button" id="impCancel">Отмена</button>
      <button class="btn primary" type="button" id="impApply" hidden>Загрузить</button>
    </footer>
  </div>
</div>

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-labelledby="lbT" hidden>
  <button class="lb-x" type="button" id="lbX" aria-label="Закрыть">×</button>
  <button class="lb-nav prev" type="button" id="lbPrev" aria-label="Предыдущая модель"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
  <figure class="lb-fig">
    <div class="lb-imgw"><img id="lbImg" alt=""></div>
    <figcaption class="lb-cap"><div class="lb-t" id="lbT"></div><div class="lb-n" id="lbN"></div><div class="lb-sz" id="lbSz"></div><div class="lb-pos" id="lbPos"></div></figcaption>
  </figure>
  <button class="lb-nav next" type="button" id="lbNext" aria-label="Следующая модель"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
</div>
<div class="modal" id="empDlg" role="dialog" aria-modal="true" aria-labelledby="empDlgT" hidden>
  <div class="sheet" style="max-width:420px">
    <header><h2 id="empDlgT">Выйти из режима сотрудника?</h2><button class="x" type="button" id="empDlgX" aria-label="Закрыть">×</button></header>
    <form class="sbody" id="empDlgForm" autocomplete="off">
      <p class="hint" id="empDlgHint" style="margin:0"></p>
      <label class="fld" id="empDlgPinWrap">Код<input class="in" id="empDlgPin" inputmode="numeric" maxlength="6" autocomplete="off"></label>
