/* ---------- undo: «Оформить закупку» and «Провести приёмка» can be taken back for 10 seconds ---------- */
function takeSnap() {
  const cl = o => JSON.parse(JSON.stringify(o));
  return {
    stock: new Map([...stock.items].map(([k, it]) => [k, {...it}])),
    lines: new Map([...lines.items].map(([k, it]) => [k, {...it, w: {...it.w}}])),
    pur: new Map([...PUR].map(([id, x]) => [id, cl(x)])),
    po: new Map([...PO].map(([k, e]) => [k, {...e}])), sent: new Map(SENT), skip: {m: new Set(SKIP.m), p: new Set(SKIP.p)},
    ret: RET.map(r => ({...r})), sup: new Map([...SUPSTAT].map(([k, v]) => [k, {...v}])), log: LOG.slice(),
    models: cl(META['meta/models']()), draft: new Map([...draft.items].map(([k, it]) => [k, {...it}])),
  };
}
function restoreMap(m, snap) {
  for (const k of [...m.items.keys()]) if (!snap.has(k)) m.remove(k);
  for (const [k, it] of snap) { const cur = m.items.get(k); if (!cur || JSON.stringify(m.o.pack(cur)) !== JSON.stringify(m.o.pack(it))) { m.items.set(k, it); m.touch(k); } }
}
function restoreSnap(sn) {
  if (JSON.stringify(META['meta/models']()) !== JSON.stringify(sn.models)) { loadModels(sn.models); saveMeta('meta/models'); for (const m of maps) m.rekey(); for (const p of PUR.values()) for (const l of p.lines) l.k = akey(l.a); }
  restoreMap(stock, sn.stock); restoreMap(lines, sn.lines); restoreMap(draft, sn.draft);
  for (const id of [...PUR.keys()]) if (!sn.pur.has(id)) { PUR.delete(id); savePur(id, 50); }
  for (const [id, x] of sn.pur) { const cur = PUR.get(id); if (!cur || JSON.stringify(purToDoc(cur)) !== JSON.stringify(purToDoc(x))) { PUR.set(id, x); savePur(id, 50); } }
  PO = sn.po; SENT = sn.sent; SKIP.m = sn.skip.m; SKIP.p = sn.skip.p; saveMeta('meta/po');
  RET = sn.ret; saveMeta('meta/returns');
  SUPSTAT.clear(); for (const [k, v] of sn.sup) SUPSTAT.set(k, v); saveMeta('meta/supstats');
  LOG = sn.log; saveMeta('meta/log');
}
function toastUndo(msg, snap, what, after) {
  disarmUndo();
  UNDO = {snap, what, after, epoch: dataEpoch, t: setTimeout(disarmUndo, 10000)};
  toast(msg, 10000, {label: 'Отменить', fn: doUndo});
}
function disarmUndo() {
  if (!UNDO) return;
  clearTimeout(UNDO.t); UNDO = null;
  const b = $('#toast .tu'); if (b) b.remove();
}
function doUndo() {
  if (!UNDO) { toast('Отменить уже нельзя: после этого данные менялись'); return; }
  const u = UNDO; clearTimeout(u.t); u.restoring = true;
  restoreSnap(u.snap);
  UNDO = null;
  log(`Отменено: ${u.what}`); diag('undo', u.what);
  if (u.after) u.after();
  render(); toast(`Отменено: ${u.what}. Всё как было.`);
}

