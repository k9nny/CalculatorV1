  return m ? m[1] + m[2] : t;
}
const artCache = new Map(), modCache = new Map();
const clearArt = () => { artCache.clear(); modCache.clear(); keyCache.clear(); };
// the article as written: pavilion, model, size and the price inside it
function parseRaw(a) {
  const s = String(a ?? '').trim();
  const ck = (S.pav ? '1' : '0') + s;
  let r = artCache.get(ck);
  if (r) return r;
  const parts = s.split('-');
  let size = '', model = s;
  if (parts.length > 1 && SIZE_RX.test(latinUp(parts[parts.length - 1]).replace(/\s+/g, ''))) { size = parts.pop().trim(); model = parts.join('-'); }
  const pn = pavParts(parts);
  const pav = pn ? normPav(parts.slice(0, pn).join('-')) : '';
  // the price is a round number (К18-900-777-2-XL: 900, not the model number 777; 1990 counts too)
  let price = 0, e50 = 0, e10 = 0;
