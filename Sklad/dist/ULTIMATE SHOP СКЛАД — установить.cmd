let SEQ = 0;
const tick = () => (SEQ = Math.max(SEQ + 1, Date.now()));

// A04-LM9-Ser-1900-3XL → павильон A04, модель A04-LM9-Ser-1900, размер 3XL
const SIZE_RX = /^(\d{2,3}(\/\d{2,3})?|\d?X{0,4}[SML]|XXS|ONESIZE|OS)$/;
