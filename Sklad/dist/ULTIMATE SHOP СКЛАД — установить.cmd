  <main class="needs-data">
    <!-- СВОДКА -->
    <section class="pane home" id="pane-home" role="tabpanel" aria-labelledby="t-home" hidden>
      <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="hsum" id="hSum"></p>
      <div class="bento" id="bento">
        <article class="w wl w-rings" data-go="day" tabindex="0" aria-labelledby="wRingsH">
