          <div class="ai" id="hAi" hidden><div class="ai-in"><div class="ai-top"><span class="ai-lbl">Claude · разбор дня</span><button class="x" type="button" id="hAiStop" aria-label="Остановить">×</button></div><div class="ai-text" id="hAiText" aria-live="polite"></div></div></div>
          <ul class="tips" id="hTips"></ul>
