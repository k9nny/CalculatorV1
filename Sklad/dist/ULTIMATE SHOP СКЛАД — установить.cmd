/* ---------- the same coat in two shops: the owner confirms, the program joins ---------- */
const TWV = {focus: '', q: '', more: 30, hashing: false};
async function photoHash(mk) {
  if (PH_HASH.has(mk)) return PH_HASH.get(mk);
  const im = await loadImg(photoUrl.get(mk));
  let h = '';
  if (im) {
    const cv = document.createElement('canvas'); cv.width = 9; cv.height = 8;
    const g = cv.getContext('2d', {willReadFrequently: true}); g.drawImage(im, 0, 0, 9, 8);
    const d = g.getImageData(0, 0, 9, 8).data, lum = i => d[i] * 0.3 + d[i + 1] * 0.59 + d[i + 2] * 0.11;
    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) { const i = (y * 9 + x) * 4; h += lum(i) > lum(i + 4) ? '1' : '0'; }
  }
  PH_HASH.set(mk, h); return h;
}
// 0 = the same picture, up to 64 = nothing alike; null while unknown or without photos
function photoDist(a, b) {
  const x = PH_HASH.get(a), y = PH_HASH.get(b);
  if (!x || !y) return null;
  let n = 0; for (let i = 0; i < 64; i++) if (x[i] !== y[i]) n++;
  return n;
}
async function hashPairs(pairs) {
  const need = [...new Set(pairs.flatMap(c => [c.main.mk, c.other.mk]))].filter(mk => !PH_HASH.has(mk) && photoUrl.has(mk));
  if (!need.length || TWV.hashing) return;
  TWV.hashing = true;
  try { for (const mk of need) await photoHash(mk); } finally { TWV.hashing = false; }
  if (!$('#tw').hidden) renderTw();
}
const twSure = c => { const d = photoDist(c.main.mk, c.other.mk); return (c.sure && (d == null || d <= 20)) || (d != null && d <= 8 && c.sc >= 0.6); };
function twSide(m) {
  const sizes = [...new Set([...m.sizes].map(sizeShow))].sort(bySize);
  return `<div class="twside">${thumb(m.mk, 'sm', true)}<div><span class="art">${esc(shortModel(m.model))}</span>${m.n ? `<span class="nm">${esc(m.n)}</span>` : ''}<div class="twmeta">${esc(pavLabel(m.pav))}${sizes.length ? ` · ${esc(sizes.slice(0, 8).join(', '))}${sizes.length > 8 ? '…' : ''}` : ''}${m.q ? ` · ${fmt(round(m.q))} шт. в заказах и на складе` : ''}</div></div></div>`;
}
function renderTw() {
  const {list, M} = twinSuggest(), box = $('#twBody');
  const done = [...TWIN].map(([k, t]) => ({k, t, m: M.get(k), main: M.get(t.to)})).filter(x => x.m || x.main);
  const doneHtml = done.length ? `<div class="twdone"><h3>Уже объединены (${fmt(done.length)})</h3>${done.map(x => `<div class="twrow"><span><b class="art">${esc(shortModel((x.main || parseRaw(x.t.a)).model))}</b> = <b class="art">${esc(x.m ? shortModel(x.m.model) : x.k)}</b></span><button class="btn sm ghost" type="button" data-tw-split="${esc(x.k)}">Разъединить</button></div>`).join('')}</div>` : '';
  const intro = '<p class="hint" style="margin:0 0 14px">Если одна и та же шуба продаётся в двух магазинах под разными артикулами, объедините их. Заказы обоих магазинов сложатся в одну строку закупки, остаток на складе станет общим, а в заказах Озона у каждого магазина останется свой артикул.</p>';
  if (TWV.focus) {
    const me = M.get(TWV.focus) || [...M.values()].find(m => TWIN.has(m.mk) ? false : parseArt(m.a).mkey === TWV.focus);
    if (!me) { TWV.focus = ''; renderTw(); return; }
    let cand = twinRank(me.mk);
    if (TWV.q) cand = [...M.values()].filter(m => m.mk !== me.mk && !TWIN.has(m.mk) && matches(TWV.q, m.model, m.n, m.a)).map(m => ({m, sc: 0}));
    box.innerHTML = `${intro}<div class="twpair pick" style="border-color:var(--ink)">${twSide(me)}<span class="chip good">этот товар</span></div>
      <div class="twhead" style="margin-top:16px"><h3>Какой товар другого магазина — такой же?</h3><input class="in search" id="twQ" placeholder="Поиск по артикулу или названию" value="${esc(TWV.q)}" aria-label="Поиск товара"></div>
      ${cand.slice(0, 12).map(c => `<div class="twpair pick">${twSide(c.m)}<button class="btn primary" type="button" data-tw-join="${esc(me.mk)}" data-tw-other="${esc(c.m.mk)}">Это он</button></div>`).join('') || `<p class="hint">${TWV.q ? 'Ничего не нашлось. Попробуйте часть артикула.' : 'В этом павильоне больше нет товаров. Найдите нужный поиском.'}</p>`}
      ${TWV.q ? '' : '<p class="hint small" style="margin-top:10px">Сверху самые похожие товары того же павильона. Если нужного нет, найдите его поиском.</p>'}${doneHtml}`;
    hashPairs(cand.slice(0, 12).map(c => ({main: me, other: c.m})));
    return;
  }
  const sure = list.filter(twSure);
  box.innerHTML = `${intro}${list.length ? `<div class="twhead"><h3>Похожие пары: ${fmt(list.length)}</h3>${sure.length ? `<button class="btn primary" type="button" data-tw-all>Объединить все уверенные (${fmt(sure.length)})</button>` : ''}</div>` : '<p class="empty" style="padding:18px 0">Похожих пар не нашлось. Если программа что-то пропустила, нажмите «Объединить» у модели на вкладке «Закупка».</p>'}
    ${list.slice(0, TWV.more).map((c, i) => { const d = photoDist(c.main.mk, c.other.mk); return `<div class="twpair" data-tw-i="${i}">${twSide(c.main)}<span class="tweq" aria-hidden="true">=</span>${twSide(c.other)}<div class="twact"><span class="why">похожи на ${Math.round(c.sc * 100)}%${d == null ? '' : d <= 8 ? ' · <b>фото одинаковые</b>' : d > 20 ? ' · фото разные' : ''}</span><button class="btn ghost" type="button" data-tw-no="${i}">Разные товары</button><button class="btn primary" type="button" data-tw-yes="${i}">Один товар</button></div></div>`; }).join('')}
    ${list.length > TWV.more ? `<button class="btn more" type="button" data-tw-more>Показать ещё ${fmt(Math.min(30, list.length - TWV.more))}</button>` : ''}${doneHtml}`;
  hashPairs(list.slice(0, TWV.more));
}
function openTwins(mk) {
  TWV.focus = mk || ''; TWV.q = ''; TWV.more = 30;
  renderTw(); showModal('#tw');
  $('#twBody').scrollTop = 0;
}
function joinWithUndo(pairs, what) {
  const snap = takeSnap();
  joinTwins(pairs.map(c => [c.main, c.other]));
  log(`Объединены одинаковые товары двух магазинов: ${pairs.map(c => `${shortModel(c.main.model)} = ${shortModel(c.other.model)}`).slice(0, 12).join(', ')}${pairs.length > 12 ? '…' : ''}`);
  diag('twins', 'join', {n: pairs.length});
  render(); if (!$('#tw').hidden) renderTw();
  toastUndo(what, snap, 'объединение товаров');
}
$('#twBody').addEventListener('click', e => {
  const t = e.target.closest('[data-tw-yes],[data-tw-no],[data-tw-all],[data-tw-more],[data-tw-join],[data-tw-split]'); if (!t) return;
  const {list, M} = twinSuggest();
  if (t.dataset.twYes != null) { const c = list[+t.dataset.twYes]; if (c) joinWithUndo([c], `Объединено: ${shortModel(c.main.model)} и ${shortModel(c.other.model)}`); }
  else if (t.dataset.twNo != null) {
    const c = list[+t.dataset.twNo]; if (!c) return;
    const done = () => { NOTWIN.add(pairKey(c.main.mk, c.other.mk)); MODV++; saveMeta('meta/models'); renderTw(); render(); };
    const el = t.closest('.twpair');
