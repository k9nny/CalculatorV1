      <div class="row" style="justify-content:flex-end;gap:8px"><button class="btn" type="button" id="empDlgNo">Остаться</button><button class="btn primary" type="submit">Выйти</button></div>
    </form>
  </div>
</div>
<div class="modal" id="ord" role="dialog" aria-modal="true" aria-labelledby="ordTitle" hidden>
  <div class="sheet ordsheet">
    <header><h2 id="ordTitle">Заказ с фото</h2><button class="x" type="button" id="ordX" aria-label="Закрыть">×</button></header>
    <div class="sbody">
      <ol class="ordsteps" id="ordSteps"></ol>
      <div class="ordpages" id="ordPages" aria-live="polite"></div>
    </div>
    <footer>
      <button class="btn" type="button" id="ordImg"><svg class="ic"><use href="#i-dl"/></svg>Сохранить картинкой</button>
      <button class="btn primary" type="button" id="ordPdf"><svg class="ic"><use href="#i-doc"/></svg>Сохранить PDF</button>
