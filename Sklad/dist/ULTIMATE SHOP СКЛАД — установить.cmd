<style>
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
:root{
  --bg:#E9ECEE; --surface:#FFFFFF; --surface-2:#F3F5F6; --ink:#15191E; --muted:#56606A; --line:#D2D7DC;
  --accent:#FFC20E; --accent-edge:#DDA600; --accent-ink:#15191E; --accent-soft:#FFF3C7;
  --bad:#B3342A; --bad-soft:#FBE6E3; --good:#22704A; --good-soft:#E0F1E7; --warn:#9A5400; --warn-soft:#FCEBD6;
  --focus:#1D5FD1; --hazard:#15191E; --scrim:rgba(12,14,17,.55);
  --r:10px;
  --f-ui:"Golos Text","Segoe UI",Roboto,Arial,sans-serif;
  --f-mono:"JetBrains Mono",Consolas,"Courier New",monospace;
  --f-display:"Unbounded","Golos Text","Arial Black",sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#111316; --surface:#1A1E22; --surface-2:#22272C; --ink:#E6E9EC; --muted:#9BA4AD; --line:#30373E;
    --accent:#FFC20E; --accent-edge:#FFC20E; --accent-ink:#15191E; --accent-soft:#3A3112;
    --bad:#FF7F72; --bad-soft:#3B1E1B; --good:#5FCB91; --good-soft:#15301F; --warn:#F2A64B; --warn-soft:#37270F;
    --focus:#80A8FF; --scrim:rgba(0,0,0,.65);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#111316; --surface:#1A1E22; --surface-2:#22272C; --ink:#E6E9EC; --muted:#9BA4AD; --line:#30373E;
  --accent:#FFC20E; --accent-edge:#FFC20E; --accent-ink:#15191E; --accent-soft:#3A3112;
  --bad:#FF7F72; --bad-soft:#3B1E1B; --good:#5FCB91; --good-soft:#15301F; --warn:#F2A64B; --warn-soft:#37270F;
  --focus:#80A8FF; --scrim:rgba(0,0,0,.65);
  color-scheme:dark;
}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--f-ui)}
body.noscroll{overflow:hidden}
.app{max-width:1120px;margin:0 auto;padding-inline:16px;padding-block:14px 72px}
@media (min-width:760px){.app{padding-inline:28px}}

/* header */
.top{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px 32px;padding-block:6px 14px}
.brand{margin-right:auto;min-width:0}
.logo{font:800 30px/1.05 var(--f-display);text-transform:uppercase;letter-spacing:.02em;display:flex;flex-wrap:wrap;gap:0 .35em}
.logo span{color:var(--muted)}
@media (max-width:560px){.logo{font-size:22px}}
.tagline{color:var(--muted);font-size:13px;margin-top:7px;letter-spacing:.05em}
.kpi{display:flex;flex-direction:column;gap:2px}
.kpi .num{font:700 24px/1.05 var(--f-mono);font-variant-numeric:tabular-nums}
.kpi .lbl{font-size:12px;color:var(--muted)}
.sync{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);max-width:260px}
@media (max-width:560px){.brand{flex-basis:100%}.top{gap:10px 24px}.sync{flex-basis:100%}}
.sync i{width:8px;height:8px;border-radius:50%;background:var(--muted);flex:none}
.sync[data-s="ok"] i{background:var(--good)}
.sync[data-s="busy"] i,.sync[data-s="wait"] i{background:var(--accent-edge)}
.sync[data-s="err"] i{background:var(--bad)}
.sync[data-s="err"]{color:var(--bad)}
.stripe{height:8px;border-radius:2px;background:repeating-linear-gradient(-45deg,var(--accent) 0 12px,var(--hazard) 12px 24px)}

/* tabs */
.tabs{display:flex;gap:2px;margin-block:12px 18px;overflow-x:auto;border-bottom:1px solid var(--line);scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{appearance:none;border:0;background:none;color:var(--muted);font:600 15px/1 var(--f-ui);padding:13px 14px 14px;border-bottom:3px solid transparent;margin-bottom:-1px;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:8px}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent-edge)}
.badge{font:700 11px/1 var(--f-mono);background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:3px 7px;color:var(--ink)}
.badge.hot{background:var(--accent);border-color:var(--accent-edge);color:var(--accent-ink)}

/* layout pieces */
.stack{display:grid;gap:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px}
@media (max-width:560px){.card{padding:14px}}
h2{font:700 19px/1.25 var(--f-ui);margin:0;text-wrap:balance}
h3{font:600 16px/1.3 var(--f-ui);margin:0}
.hint{color:var(--muted);margin:6px 0 0;font-size:14px;max-width:70ch}
.small{font-size:13px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.mt{margin-top:14px}
.steps{margin:14px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;counter-reset:s}
.steps li{counter-increment:s;background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:10px 12px 10px 44px;position:relative;font-size:14px}
.steps li::before{content:counter(s);position:absolute;left:12px;top:10px;width:22px;height:22px;border-radius:4px;background:var(--hazard);color:var(--accent);font:700 13px/22px var(--f-mono);text-align:center}
.steps b{display:block}

/* form controls */
.fld{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--muted);font-weight:500;letter-spacing:.02em;min-width:0}
.in{font:16px/1.3 var(--f-ui);color:var(--ink);background:var(--surface);border:1.5px solid var(--line);border-radius:8px;padding:10px 12px;min-width:0;width:100%}
select.in{padding-right:8px}
.in.mono{font-family:var(--f-mono)}
.in.big{font:500 20px/1.2 var(--f-mono);padding:12px 14px}
.in:focus{outline:none;border-color:var(--focus);box-shadow:0 0 0 3px color-mix(in srgb,var(--focus) 22%,transparent)}
.scan{display:grid;grid-template-columns:1fr 120px auto;gap:10px;align-items:end;margin-top:16px}
@media (max-width:560px){.scan{grid-template-columns:1fr 92px}.scan .btn{grid-column:1/-1}}
.scaninfo{min-height:22px;margin-top:10px;font-size:14px;color:var(--muted)}
.scaninfo b{font-family:var(--f-mono);color:var(--ink)}

.btn{appearance:none;font:600 14px/1.2 var(--f-ui);color:var(--ink);background:var(--surface-2);border:1.5px solid var(--line);border-radius:8px;padding:10px 14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;text-align:left}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);border-color:var(--accent-edge);color:var(--accent-ink)}
.btn.primary:hover{border-color:var(--hazard)}
.btn.ghost{background:transparent;border-color:transparent}
.btn.ghost:hover{border-color:var(--line)}
.btn.danger{color:var(--bad)}
.btn.solid-danger{background:var(--bad);border-color:var(--bad);color:#fff}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn:focus-visible,.tab:focus-visible,.seg button:focus-visible,.x:focus-visible,.mode:focus-within{outline:3px solid var(--focus);outline-offset:2px}

/* lists and tables */
.lhead{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-bottom:12px}
.lhead .sum{color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}
.lhead .search{margin-left:auto;width:min(300px,100%)}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:8px;max-height:70vh;overflow-y:auto}
table.t{width:100%;border-collapse:collapse;font-size:14px}
.t th{text-align:left;font:600 11.5px/1.2 var(--f-ui);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--surface-2);padding:10px 12px;border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0;z-index:1}
.t th.num{text-align:right}
.t td{padding:8px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
.t tbody tr:last-child td{border-bottom:0}
.t .num{text-align:right;font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
.t .strong{font-weight:700}
.t td.c{width:44px;text-align:center;padding-inline:4px}
.art{font-family:var(--f-mono);font-weight:700;word-break:break-all}
.nm{display:block;color:var(--muted);font-size:13px;margin-top:2px;max-width:52ch}
.alias{display:block;font-size:12px;color:var(--muted);margin-top:2px}
