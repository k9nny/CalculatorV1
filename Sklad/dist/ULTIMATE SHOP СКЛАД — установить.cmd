  const twN = twinSuggest().list.length;
  if (twN) T.push({sv: 'info', b: `Одинаковые товары в двух магазинах: ${fmt(twN)} ${plural(twN, ['пара', 'пары', 'пар'])}`, d: 'Объедините их — заказы обоих магазинов сложатся в одну строку закупки.', act: '<button class="btn" type="button" data-twin="*">Проверить</button>'});
  if (D.pendQ && !D.short) T.push({sv: 'info', b: 'Товар со склада ещё не списан', d: `${fmt(round(D.pendQ))} шт. отложено под отправления, спишите их.`, act: '<button class="btn" type="button" data-go="day">К заказам</button>'});
  if (D.noPhone.length) T.push({sv: 'info', b: `Нет телефона поставщика: ${D.noPhone.slice(0, 3).map(x => x.pav || '—').join(', ')}${D.noPhone.length > 3 ? '…' : ''}`, d: 'С номером заказ уходит в WhatsApp одной кнопкой.', act: '<button class="btn" type="button" data-go="settings">Указать</button>'});
  if (D.deadQ >= 5) T.push({sv: 'warn', b: `Залежалось ${fmt(round(D.deadQ))} шт.${D.deadM ? ` на ${rubShort(D.deadM)}` : ''}`, d: 'Эти деньги стоят без движения. Снизьте цену и не докупайте.', act: '<button class="btn" type="button" data-go="an">Что снизить</button>'});
  if (D.hot) T.push({sv: 'info', b: `${cnt(D.hot, W.model)} хорошо продаются, а на складе мало`, d: 'Можно закупить больше или поднять цену.', act: '<button class="btn" type="button" data-go="an">Посмотреть</button>'});
  const szTot = [...D.sizes.values()].reduce((a, b) => a + b, 0);
  if (szTot >= 30) { const [sz, q] = [...D.sizes.entries()].sort((a, b) => b[1] - a[1])[0]; const sh = q / szTot; if (sh >= 0.35) T.push({sv: 'info', b: `Перекос по размерам: ${sz} — ${Math.round(sh * 100)}% склада`, d: 'Этот размер лучше пока не докупать.', act: '<button class="btn" type="button" data-go="stock">Склад</button>'}); }
