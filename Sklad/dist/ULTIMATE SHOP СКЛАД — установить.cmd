/* ============ motion layer ============ */
:root{--ease-out:cubic-bezier(.2,.8,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--spring-soft:cubic-bezier(.22,1.2,.36,1)}
@supports (transition-timing-function:linear(0,1)){:root{--spring:linear(0, .049, .171, .334, .511, .682, .832, .954, 1.044, 1.104, 1.137, 1.148, 1.142, 1.124, 1.1, 1.074, 1.049, 1.026, 1.008, .994, .985, .98, .978, .979, .981, .985, .989, .992, .996, .999, 1.001, 1.002, 1.003, 1.003, 1.003, 1.003, 1);--spring-soft:linear(0, .022, .078, .155, .245, .34, .434, .524, .607, .683, .749, .806, .855, .895, .928, .955, .975, .991, 1.002, 1.01, 1.015, 1.018, 1.02, 1.02, 1.019, 1.018, 1.016, 1.014, 1.013, 1.011, 1.009, 1.007, 1.006, 1.005, 1.004, 1.003, 1)}}
/* buttons follow the cursor: lift, a soft light under the pointer, a press that gives */
.btn{position:relative;isolation:isolate;overflow:hidden;transition:transform .55s var(--spring),box-shadow .3s var(--ease-out),background-color .2s,border-color .2s,opacity .2s;will-change:transform}
.btn::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;background:radial-gradient(120px circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--ink) 9%,transparent),transparent 70%);opacity:0;transition:opacity .25s}
.btn.primary::before{background:radial-gradient(140px circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.22),transparent 70%)}
.btn.wa::before{background:radial-gradient(140px circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.28),transparent 70%)}
.btn.primary::after,.btn.wa::after{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.28) 50%,transparent 65%);transform:translateX(-120%);pointer-events:none}
@media (hover:hover){
  .btn:not(:disabled):hover{transform:translate(var(--tx,0),calc(var(--ty,0px) - 1.5px));box-shadow:0 8px 20px -10px rgba(0,0,0,.35)}
  .btn:not(:disabled):hover::before{opacity:1}
  .btn.primary:not(:disabled):hover::after,.btn.wa:not(:disabled):hover::after{animation:sheen .9s var(--ease-out)}
}
.btn:not(:disabled):active{transform:scale(.965);transition-duration:.08s;box-shadow:none}
.btn:disabled{opacity:.45;cursor:default}
@keyframes sheen{to{transform:translateX(120%)}}
.x{transition:transform .45s var(--spring),background-color .2s,color .2s}
@media (hover:hover){.x:hover{transform:rotate(90deg) scale(1.08)}}
/* cards that answer the pointer: a light border that follows it */
.tile,.kpi,.ppc,.go,.w{position:relative;isolation:isolate;transition:transform .6s var(--spring),box-shadow .35s var(--ease-out),border-color .25s}
.tile::after,.kpi::after,.ppc::after,.go::after,.w::after{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;pointer-events:none;z-index:2;
  background:radial-gradient(220px circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--gold) 85%,transparent),transparent 65%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);opacity:0;transition:opacity .3s}
@media (hover:hover){
  .tile:hover,.kpi:hover,.go:hover{transform:translateY(-2px);box-shadow:0 1px 2px rgba(0,0,0,.05),0 18px 40px -22px rgba(0,0,0,.35)}
  .tile:hover::after,.kpi:hover::after,.ppc:hover::after,.go:hover::after,.w:hover::after{opacity:1}
  .ppc:hover{transform:translateY(-2px)}
}
.ppc:active{transform:scale(.96);transition-duration:.08s}
.ppc[aria-pressed="true"]{transition:transform .6s var(--spring),background-color .3s,color .3s,border-color .3s}
/* sidebar: one pill glides to the chosen section */
@media (min-width:1024px){.side .tabs{position:relative}}
.side .tab{position:relative;z-index:1;background:transparent!important}
.side .tab:hover{color:var(--side-ink)}
.side .tab .ic{transition:transform .5s var(--spring),color .25s}
@media (hover:hover){.side .tab:hover .ic{transform:scale(1.14) rotate(-4deg)}}
.tabpill{position:absolute;left:0;top:0;width:0;height:0;border-radius:10px;background:var(--side-2);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);z-index:0;pointer-events:none;transition:transform .6s var(--spring),width .6s var(--spring),height .6s var(--spring),opacity .2s;opacity:0}
.tabpill::before{content:"";position:absolute;left:0;top:22%;bottom:22%;width:3px;border-radius:0 3px 3px 0;background:var(--side-gold)}
.tabpill.on{opacity:1}
@media (max-width:1023px){.tabpill::before{left:30%;right:30%;top:auto;bottom:0;width:auto;height:3px;border-radius:3px 3px 0 0}}
/* segmented controls: the thumb slides */
.seg{position:relative}
.seg button{position:relative;z-index:1;background:transparent!important;box-shadow:none!important;transition:color .25s}
.segthumb{position:absolute;top:3px;left:0;height:calc(100% - 6px);width:0;border-radius:8px;background:var(--surface);box-shadow:0 1px 2px rgba(0,0,0,.1),0 0 0 1px var(--line),0 6px 14px -8px rgba(0,0,0,.25);transition:transform .55s var(--spring),width .55s var(--spring);z-index:0;pointer-events:none}
/* iOS-style switches in the settings */
.opt input[type=checkbox]{appearance:none;-webkit-appearance:none;width:48px;height:28px;border-radius:999px;margin:0;flex:none;cursor:pointer;
  background:color-mix(in srgb,var(--muted) 35%,var(--surface-2)) radial-gradient(circle at 14px 14px,#fff 0 11px,rgba(0,0,0,.14) 11.5px 12.5px,transparent 13px) no-repeat;
  background-size:48px 28px;background-position:0 0;transition:background-color .3s,background-position .5s var(--spring)}
.opt input[type=checkbox]:checked{background-color:var(--good);background-position:20px 0}
.opt input[type=checkbox]:active{background-size:52px 28px}
.opt input[type=checkbox]:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
/* rolling digits */
.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
.odo .odr::before{content:"0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9";white-space:pre;display:block;line-height:1.15;text-align:center}
.odo .os::before{content:attr(data-c)}
.odo{font-variant-numeric:tabular-nums}
.pane{animation:none}
.segbar span{transform-origin:left center}
.chart .b{transform-box:fill-box;transform-origin:50% 100%}
.odo{display:inline-flex;align-items:baseline;white-space:nowrap}
.odo .od{display:inline-block;height:1.15em;line-height:1.15;overflow:hidden;vertical-align:bottom;-webkit-mask:linear-gradient(transparent,#000 22%,#000 78%,transparent);mask:linear-gradient(transparent,#000 22%,#000 78%,transparent)}
.odo .odr{display:flex;flex-direction:column;transition:transform .9s var(--spring-soft)}
.odo .os{white-space:pre}
.badge.pop{animation:pop .55s var(--spring)}
@keyframes pop{0%{transform:scale(.6)}100%{transform:scale(1)}}
/* the Dynamic-Island message */
.toast{top:calc(env(safe-area-inset-top,0px) + 14px);bottom:auto;left:50%;transform:translateX(-50%);background:#0B0B0D;color:#F4F4F6;border-radius:999px;padding:11px 20px 11px 14px;display:flex;align-items:center;gap:11px;font:500 14px/1.3 var(--f-ui);box-shadow:0 18px 50px -12px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.06);z-index:95;max-width:min(560px,calc(100% - 24px));animation:island .7s var(--spring) both}
.toast.out{animation:islandOut .35s var(--ease-out) both}
.toast .ti{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;flex:none;background:#1F2A22;color:#6EE7A1}
.toast .ti.err{background:#3A1D1B;color:#FF8A7E}
.toast .ti svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.toast .ti svg path{stroke-dasharray:24;stroke-dashoffset:24;animation:draw .5s .25s var(--ease-out) forwards}
.toast .tt{min-width:0;animation:fadeIn .3s .18s both}
@keyframes island{0%{clip-path:inset(0 calc(50% - 22px) round 999px);transform:translateX(-50%) translateY(-6px) scale(.8);opacity:.2}55%{opacity:1}100%{clip-path:inset(0 0 round 999px);transform:translateX(-50%);opacity:1}}
@keyframes islandOut{to{clip-path:inset(0 calc(50% - 22px) round 999px);transform:translateX(-50%) translateY(-8px) scale(.85);opacity:0}}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
/* dialogs */
.modal:not([hidden]){animation:fadeIn .25s ease-out}
.modal:not([hidden]) .sheet{animation:sheetIn .6s var(--spring)}
@keyframes sheetIn{from{opacity:0;transform:translateY(18px) scale(.965)}to{opacity:1;transform:none}}
/* page title swaps like a flip board */
#pageTitle.swap{animation:titleIn .6s var(--spring)}
@keyframes titleIn{from{opacity:0;transform:translateY(55%);filter:blur(6px)}to{opacity:1;transform:none;filter:none}}
/* the brand mark catches the light */
.mark{position:relative;overflow:hidden}
.mark::after{content:"";position:absolute;inset:-40%;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.65) 50%,transparent 60%);transform:translateX(-100%);animation:markSheen 1.4s .5s var(--ease-out) both}
.brand:hover .mark::after{animation:markSheen 1.1s var(--ease-out)}
@keyframes markSheen{to{transform:translateX(100%)}}
/* rows and steppers */
.t tbody td{transition:background-color .2s}
.cnt{transition:background-color .35s}
.cnt.ok{background:linear-gradient(90deg,color-mix(in srgb,var(--good) 9%,transparent),transparent 70%)}
.step button{transition:transform .5s var(--spring),background-color .2s}
@media (hover:hover){.step button:hover{transform:translateY(-1px)}}
.step button:active{transform:scale(.9);transition-duration:.06s}
.in{transition:border-color .2s,box-shadow .3s var(--ease-out)}
.chip{transition:background-color .3s,color .3s}

