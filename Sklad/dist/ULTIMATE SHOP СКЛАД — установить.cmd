// Claude reads today's numbers and says what to do first
function briefPrompt(D) {
  const L = [];
  L.push(`Отправлений в работе: ${D.all}; можно собрать сейчас: ${D.pick}; ждут мешок от поставщика: ${D.wait}; не хватает товара: ${D.short} (${fmt(round(D.shortQ))} шт.).`);
  if (D.pavs.length) L.push(`Закупка: нужно заказать ${fmt(D.orderQ)} шт. в ${D.pavs.length} павильонах${D.money ? ` примерно на ${rub(D.money)}` : ''}; заказ отправлен в ${D.sent} из ${D.pavs.length}. Больше всего: ${D.pavs.slice(0, 5).map(pv => `${pv.pav || 'без павильона'} ${fmt(pv.order)} шт.`).join(', ')}.`);
  if (D.go.length) L.push(`В пути: ${D.go.length} мешков, ${fmt(D.goQ)} шт.; дольше всех едет мешок из ${D.oldest.pav || '—'} — ${daysSince(D.oldest.at)} дн.`);
  L.push(`Склад: ${fmt(round(D.stQ))} шт.${D.stM ? ` примерно на ${rub(D.stM)}` : ''}; залежалось ${fmt(round(D.deadQ))} шт.${D.deadM ? ` на ${rub(D.deadM)}` : ''}.`);
  if (D.week || D.prev) L.push(`Продажи: за последние 7 дней ${D.week} шт., неделей раньше ${D.prev} шт.`);
  if (D.top.length) L.push(`Лучше всего продаются: ${D.top.map(t => `${shortModel(t.model)} (${nf.format(Math.round(t.rate * 10) / 10)} в день, на складе ${round(t.have)})`).join('; ')}.`);
  const tot = [...D.sizes.values()].reduce((a, b) => a + b, 0);
  if (tot) L.push(`Размеры на складе: ${[...D.sizes.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5).map(([k, q]) => `${k} — ${Math.round(100 * q / tot)}%`).join(', ')}.`);
  if (D.hot) L.push(`Моделей, которые хорошо продаются, а на складе их мало: ${D.hot}.`);
  if (D.retQ) L.push(`Нужно вернуть поставщикам: ${D.retQ} шт.`);
  return `Ты помогаешь владелице небольшого бизнеса: она продаёт экошубы на Озоне по схеме FBS и докупает недостающее в ТЦ «Москва» у поставщиков по павильонам. Вот цифры её склада на сегодня:\n\n${L.map(x => '- ' + x).join('\n')}\n\nНапиши 3–4 коротких пункта: что сделать сегодня в первую очередь и почему. Пиши простыми словами, без вступления, без заголовков и без markdown. Каждый пункт с новой строки, начинай с «• ». Опирайся только на эти цифры и ничего не придумывай.`;
}
$('#hAiBtn').addEventListener('click', async () => {
  if (!SAMPLE || !HOME.D) return;
  if (HOME.ctl) HOME.ctl.abort();
  const ctl = HOME.ctl = new AbortController(), box = $('#hAi'), out = $('#hAiText');
  box.hidden = false; box.classList.remove('done'); $('#hAiStop').hidden = false;
  out.classList.add('think'); out.textContent = 'Claude смотрит на цифры…';
  if (motionOk()) box.animate([{opacity: 0, transform: 'translateY(-6px) scale(.98)'}, {opacity: 1, transform: 'none'}], {duration: 600, easing: EASE_SPRING});
  diag('ai', 'разбор дня');
  try {
    await SAMPLE(briefPrompt(HOME.D), {modelTier: 'quick', signal: ctl.signal, onText: ({text}) => { out.classList.remove('think'); out.textContent = text; }});
  } catch (e) {
    const c = e && e.code;
    out.classList.remove('think'); out.textContent = (e && e.text) || '';
    if (c === 'cancelled') { if (!out.textContent) box.hidden = true; }
    else if (['not_granted', 'sampling_disabled', 'not_declared', 'capability_disabled', 'capability_removed'].includes(c)) { box.hidden = true; $('#hAiBtn').hidden = true; toast('Разбор дня недоступен: Claude не разрешён для этой страницы'); }
    else if (c === 'rate_limited') toast('Слишком много запросов. Попробуйте через минуту.');
    else { if (!out.textContent) out.textContent = 'Не получилось получить разбор. Попробуйте ещё раз.'; diag('error', 'ai: ' + (c || '')); }
  } finally {
    if (HOME.ctl === ctl) { HOME.ctl = null; box.classList.add('done'); $('#hAiStop').hidden = true; }
  }
});
