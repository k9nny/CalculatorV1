function recountDiff() {
  const out = []; let lack = 0, extra = 0, money = 0;
  for (const k of new Set([...stock.items.keys(), ...draft.items.keys()])) {
    const st = stock.items.get(k), dr = draft.items.get(k);
    const was = st ? Math.max(0, st.q) : 0, now = dr ? dr.q : 0;
    if (was === now) continue;
    const a = (dr || st).a;
    out.push({a, n: (st && st.n) || (dr && dr.n) || '', was, now});
    if (now < was) { lack = round(lack + was - now); money += (was - now) * priceOf(a); } else extra = round(extra + now - was);
  }
  out.sort((x, y) => Math.abs(y.now - y.was) - Math.abs(x.now - x.was));
  return {out, lack, extra, money};
}
