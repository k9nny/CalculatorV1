.x{appearance:none;border:1px solid transparent;background:none;color:var(--muted);font:400 20px/1 var(--f-ui);width:34px;height:34px;border-radius:6px;cursor:pointer}
.x:hover{color:var(--bad);border-color:var(--line)}
.empty{padding:30px 16px;text-align:center;color:var(--muted)}
.more{margin-top:10px}
.chip{display:inline-flex;align-items:center;font:600 12px/1 var(--f-ui);padding:5px 8px;border-radius:999px;white-space:nowrap}
.chip.good{background:var(--good-soft);color:var(--good)}
.chip.plain{background:var(--surface-2);color:var(--muted);border:1px solid var(--line)}
.chip.bad{background:var(--bad-soft);color:var(--bad)}
.chip.warn{background:var(--warn-soft);color:var(--warn)}
.chip.new{background:var(--surface-2);color:var(--muted);border:1px solid var(--line)}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.confirm{margin-top:12px;border:1.5px solid var(--ink);border-radius:8px;padding:14px;background:var(--surface-2);display:grid;gap:12px}
.confirm p{margin:0;max-width:72ch}

/* orders */
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
@media (max-width:760px){.tiles{grid-template-columns:1fr}}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;display:flex;flex-direction:column;gap:6px}
