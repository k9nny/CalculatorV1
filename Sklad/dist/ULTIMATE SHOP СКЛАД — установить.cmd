const TAB_TITLE = {home: 'Сводка', day: 'Заказы', buy: 'Закупка', recv: 'Приёмка', stock: 'Склад', an: 'Анализ', settings: 'Настройки'};
function setTab(t) {
  if (EMP && t !== 'recv' && t !== 'stock') t = 'recv';
  const changed = ui.tab !== t;
  if (changed) diag('tab', t);
  ui.tab = t;
  $('#pageTitle').textContent = t === 'home' ? greeting() : TAB_TITLE[t] || '';
  document.body.dataset.tab = t;
  if (changed && motionOk()) { const h = $('#pageTitle'); h.classList.remove('swap'); void h.offsetWidth; h.classList.add('swap'); }
  $('#pageDate').textContent = new Date().toLocaleDateString('ru-RU', {weekday: 'long', day: 'numeric', month: 'long'});
  if (t === 'an') { if (HIST === null) loadHist(); render(); }
  if (t === 'home') { if (HIST === null) loadHist(); renderAll(); }
  $$('.tab').forEach(b => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
  $$('.pane').forEach(p => p.hidden = p.id !== 'pane-' + t);
  lsSet('sklad/tab', t);
