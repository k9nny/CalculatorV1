  if (!t) return;
  if (t.dataset.skipM || t.dataset.skipP != null) { skipIt(t); return; }
  if (t.dataset.unskipM || t.dataset.unskipP != null || t.hasAttribute('data-unskip-all')) {
    if (t.dataset.unskipM) SKIP.m.delete(t.dataset.unskipM); else if (t.dataset.unskipP != null) { SKIP.p.delete(t.dataset.unskipP); ui.buyPav = t.dataset.unskipP; } else { SKIP.m.clear(); SKIP.p.clear(); }
    saveMeta('meta/po'); render(); return;
  }
  if (t.dataset.move) { openMove(t.dataset.move); return; }
  if (t.dataset.unmove) { const mv = MOVE.get(t.dataset.unmove); if (mv) moveModel(t.dataset.unmove, mv.from, 0, mv.from); return; }
  if (t.dataset.twin) { openTwins(t.dataset.twin === '*' ? '' : t.dataset.twin); return; }
  if (t.dataset.recvAsis) { askAsIs(t.dataset.recvAsis, t.closest('#pane-recv') ? '#recvGoConfirm' : '#goConfirm'); return; }
  if (t.hasAttribute('data-order-all')) { openOrder(null); return; }
  if (t.hasAttribute('data-order-pav')) { openOrder([t.dataset.orderPav]); return; }
  if (t.hasAttribute('data-pick-pav') || t.dataset.pavStep) {
    const keys = groupModels(buyRows(plan())).map(pv => pv.pav), i = keys.indexOf(ui.buyPav);
    if (t.dataset.pavStep) {
      const j = i < 0 ? 0 : i + +t.dataset.pavStep; if (j < 0 || j >= keys.length) return;
      ui.buyPav = keys[j];
    } else ui.buyPav = t.dataset.pickPav;
    if (ui.buyPav === keys[i]) return;
    ui.editSup = null; render();
    const j = keys.indexOf(ui.buyPav);
    slideIn($('#buyList'), ui.buyPav === '*' ? 0 : j < i ? -1 : 1);
    if (t.hasAttribute('data-scroll')) $('#pavPick').scrollIntoView({block: 'start', behavior: 'smooth'});
    return;
  }
  if (t.hasAttribute('data-wa')) {
    // the link opens WhatsApp by itself; here the pavilion is only marked as sent
    SENT.set(t.dataset.wa, Date.now()); saveMeta('meta/po'); diag('wa', t.dataset.wa);
    setTimeout(render, 300); return;
  }
  if (t.hasAttribute('data-edit-sup')) { ui.editSup = ui.editSup === t.dataset.editSup ? null : t.dataset.editSup; render(); setTimeout(() => { const f = $(`#buyList form[data-sup-form="${CSS.escape(t.dataset.editSup)}"] input`); if (f) f.focus(); }, 50); return; }
  if (t.hasAttribute('data-sup-cancel')) { ui.editSup = null; render(); return; }
  if (t.dataset.go) { if (t.dataset.pav != null) ui.buyPav = t.dataset.pav; const fromHome = ui.tab === 'home'; setTab(t.dataset.go); render(); if (fromHome) scrollTo({top: 0}); }
  else if (t.hasAttribute('data-commit')) askCommit('#dayConfirm');
  else if (t.dataset.recv) { ui.recvId = t.dataset.recv; ui.recvQ = ''; $('#recvSearch').value = ''; setTab('recv'); render(); scrollTo({top: 0}); }
  else if (t.dataset.cancelPur) {
    const x = PUR.get(t.dataset.cancelPur); if (!x) return;
    const box = t.closest('#pane-recv') ? '#recvGoConfirm' : '#goConfirm';
    confirmIn(box, `Отменить закупку ${esc(x.pav || 'без павильона')} от ${when(x.at)}? Отправления, которые её ждут, снова попадут в нехватку.`, 'Отменить закупку', () => cancelPurchase(x.id), true);
  }
  else if (t.dataset.addSize) {
    const inp = t.parentElement.querySelector('input'), size = inp.value.trim();
    if (!size) { inp.focus(); return; }
    const a = `${t.dataset.addSize}-${size}`, k = akey(a);
    const cur = PO.get(k);
    PO.set(k, {a, n: cur ? cur.n : '', q: cur && cur.q != null ? cur.q : 1, add: true}); saveMeta('meta/po');
    inp.value = ''; render();
  } else if (t.dataset.unadd) { PO.delete(t.dataset.unadd); saveMeta('meta/po'); render(); }
  else if (t.dataset.returned) {
    const r = RET[+t.dataset.returned]; if (!r) return;
    RET.splice(+t.dataset.returned, 1); saveMeta('meta/returns'); log(`Возвращено поставщику ${r.pav || ''}: ${r.a} × ${fmt(r.q)}`); render();
  }
});

