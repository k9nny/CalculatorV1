                <circle class="rt" cx="120" cy="120" r="77" style="--c:var(--ring2)"/><circle class="rv" data-i="1" cx="120" cy="120" r="77" style="--c:var(--ring2)"/>
                <circle class="rt" cx="120" cy="120" r="51" style="--c:var(--ring3)"/><circle class="rv" data-i="2" cx="120" cy="120" r="51" style="--c:var(--ring3)"/>
