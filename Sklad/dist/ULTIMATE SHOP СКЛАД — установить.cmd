.keyout{font:700 16px/1.3 var(--f-mono);padding:11px 12px;background:var(--surface-2);border-radius:8px;border:1.5px dashed var(--line);min-height:46px;word-break:break-all}

/* modal */
.modal{position:fixed;inset:0;z-index:50;background:var(--scrim);display:flex;align-items:flex-start;justify-content:center;padding:calc(env(safe-area-inset-top,0px) + 16px) 16px calc(env(safe-area-inset-bottom,0px) + 16px);overflow-y:auto}
.sheet{background:var(--surface);color:var(--ink);border-radius:12px;width:100%;max-width:980px;border:1px solid var(--line);box-shadow:0 24px 64px rgba(0,0,0,.3);display:flex;flex-direction:column;margin-block:auto}
.sheet>header{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--line)}
.sheet>header h2{margin-right:auto}
.sbody{padding:16px 18px;display:grid;gap:14px;min-width:0}
.sheet>footer{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px;padding:14px 18px;border-top:1px solid var(--line);background:var(--surface);border-radius:0 0 12px 12px;position:sticky;bottom:0}
.mapgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.prev{max-height:300px}
.prev th,.prev td{font-size:13px;white-space:nowrap}
.prev th em{display:block;font-style:normal;color:var(--accent-ink);background:var(--accent);border-radius:4px;padding:3px 6px;margin-bottom:5px;width:max-content;text-transform:none;letter-spacing:0}
.prev td.sel{background:var(--accent-soft)}
.prev .rn{color:var(--muted);font-family:var(--f-mono);width:1%}
.stats{font-size:14px;display:grid;gap:6px;background:var(--surface-2);border-radius:8px;padding:12px 14px}
.stats b{font-variant-numeric:tabular-nums}
.warnline{color:var(--warn)}
.modes{border:0;padding:0;margin:0;display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.mode{display:flex;gap:10px;align-items:flex-start;border:1.5px solid var(--line);border-radius:8px;padding:11px 12px;cursor:pointer}
.mode:has(input:checked){border-color:var(--ink);background:var(--surface-2)}
.mode input{margin:3px 0 0;accent-color:var(--ink);flex:none}
.mode b{display:block}
.mode span{color:var(--muted);font-size:13px}
textarea.paste{min-height:200px;font:13px/1.45 var(--f-mono);resize:vertical}
.cpytext{min-height:220px;font:13px/1.45 var(--f-mono)}

.toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 20px);transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:12px 16px;border-radius:8px;font-weight:500;z-index:70;width:max-content;max-width:calc(100% - 32px);box-shadow:0 8px 30px rgba(0,0,0,.25)}
.drop{position:fixed;inset:12px;border:3px dashed var(--accent-edge);border-radius:16px;background:color-mix(in srgb,var(--bg) 88%,transparent);display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;font:700 20px/1.3 var(--f-ui);z-index:40;pointer-events:none}
.loading .needs-data{opacity:.5;pointer-events:none}
/* v2 */
.sum{color:var(--muted);font-size:14px}
.track{height:8px;border-radius:4px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden;margin-top:10px}
.fill{height:100%;width:0;background:var(--accent);transition:width .3s}
@media (prefers-reduced-motion:reduce){.fill{transition:none}}
.tiles.four{grid-template-columns:repeat(4,1fr)}
@media (max-width:900px){.tiles.four{grid-template-columns:repeat(2,1fr)}}
@media (max-width:460px){.tiles.four{grid-template-columns:1fr}}
.notice{border:1.5px solid var(--accent-edge);background:var(--accent-soft);border-radius:var(--r);padding:14px 16px;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center}
.notice p{margin:0;flex:1 1 320px;max-width:72ch}
.ph{display:inline-block;flex:none;object-fit:cover;border-radius:6px;background:var(--surface-2);border:1px solid var(--line);vertical-align:middle}
.ph.sm{width:30px;height:40px}.ph.md{width:48px;height:64px}.ph.lg{width:72px;height:96px}
.prod{display:flex;gap:10px;align-items:center;min-width:0}
.prod>div{min-width:0}
.ship{font-family:var(--f-mono);font-size:13px;white-space:nowrap}
.addrow{display:grid;grid-template-columns:1fr 90px auto;gap:10px;align-items:end;margin-top:14px;max-width:640px}
.addrow.ex{grid-template-columns:1fr 80px 170px auto;max-width:none}
@media (max-width:600px){.addrow,.addrow.ex{grid-template-columns:1fr 90px}.addrow .btn,.addrow.ex label:nth-child(3){grid-column:1/-1}}
.pav{background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
.pav>header{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}
.pav>header h3{font:800 17px/1.2 var(--f-display);letter-spacing:.02em;margin-right:auto}
.pav>header .sum{color:var(--muted);font-size:14px}
.model{display:grid;grid-template-columns:auto 1fr;gap:12px 14px;padding:14px 18px;border-bottom:1px dashed var(--line)}
.model>div{min-width:0}
.model:last-child{border-bottom:0}
@media (max-width:560px){.model{padding:12px 14px}.pav>header{padding:12px 14px}}
.model h4{margin:0;font:700 15px/1.3 var(--f-mono);overflow-wrap:anywhere}
