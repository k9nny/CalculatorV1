/* ---------- home: the smart dashboard ---------- */
const greeting = () => { const h = new Date().getHours(); return h < 5 ? 'Доброй ночи' : h < 12 ? 'Доброе утро' : h < 18 ? 'Добрый день' : 'Добрый вечер'; };
const rubShort = n => n >= 1e6 ? `${nf.format(Math.round(n / 1e5) / 10)} млн ₽` : n >= 1e4 ? `${nf.format(Math.round(n / 1e3))} тыс. ₽` : rub(n);
const RING_R = [103, 77, 51];
function homeData(p, ships, rows, go) {
  const D = {all: ships.size, pick: 0, wait: 0, short: 0, shortQ: 0, pendQ: 0};
  for (const sh of ships.values()) { if (sh.state === 'ready' || sh.state === 'stock') D.pick++; else if (sh.state === 'wait') D.wait++; else if (sh.state === 'short') D.short++; }
  for (const r of p.values()) { D.shortQ += r.short; D.pendQ += r.take; }
  D.pavs = groupModels(rows).filter(pv => pv.order > 0).sort((a, b) => b.order - a.order);
  D.orderQ = round(D.pavs.reduce((a, pv) => a + pv.order, 0));
  D.money = rows.reduce((a, r) => a + r.order * priceOf(r.a), 0);
  D.sent = D.pavs.filter(pv => SENT.has(pv.pav)).length;
  D.unsent = D.pavs.filter(pv => !SENT.has(pv.pav));
  D.noPhone = D.pavs.filter(pv => !waDigits((SUP.get(pv.pav) || {}).phone));
  D.go = go; D.goQ = round(go.reduce((a, x) => a + x.lines.reduce((b, l) => b + l.q, 0), 0));
  D.oldest = go.length ? go.reduce((a, b) => a.at < b.at ? a : b) : null;
  const midnight = new Date(); midnight.setHours(0, 0, 0, 0);
  D.gotToday = 0; for (const x of PUR.values()) if (x.st === 'done' && x.doneAt >= +midnight && x.rep) D.gotToday += x.rep.got;
  D.stQ = 0; D.stM = 0; D.arts = 0; const models = new Set(); D.sizes = new Map();
  for (const it of stock.items.values()) {
    if (it.q <= 0) continue;
    D.stQ += it.q; D.stM += it.q * priceOf(it.a); D.arts++;
    const pa = parseArt(it.a); models.add(pa.mkey);
    const sz = canonSize(pa.size); D.sizes.set(sz, (D.sizes.get(sz) || 0) + it.q);
  }
  D.models = models.size;
  const A = analyze(), has = A.days > 0; D.has = has; D.A = A;
  D.deadQ = 0; D.deadM = 0;
  for (const [k, it] of stock.items) {
    if (it.q <= 0) continue;
    const idle = daysSince(Math.max(it.in || 0, it.out || 0));
    if ((idle != null && idle >= S.deadDays) || (has && A.effW >= 7 && !A.arts.has(k))) { D.deadQ += it.q; D.deadM += it.q * priceOf(it.a); }
  }
  D.days = [];
  const end = isoToday();
  for (let i = 13; i >= 0; i--) { const iso = isoAdd(end, -i), day = HIST && HIST.get(iso); let q = 0; if (day) for (const [, n] of day.values()) q += n; D.days.push({iso, q: round(q)}); }
  D.week = D.days.slice(7).reduce((a, d) => a + d.q, 0); D.prev = D.days.slice(0, 7).reduce((a, d) => a + d.q, 0);
  const top = new Map(), nm = has ? names() : new Map();
  for (const e of A.arts.values()) {
    const pa = parseArt(e.a); let t = top.get(pa.mkey);
    if (!t) top.set(pa.mkey, t = {mkey: pa.mkey, model: pa.model, pav: pa.pav, rate: 0, have: 0, n: nm.get(e.k) || ''});
    t.rate += e.rate; const st = stock.items.get(e.k); if (st && st.q > 0) t.have += st.q; if (!t.n) t.n = nm.get(e.k) || '';
  }
  D.top = [...top.values()].sort((a, b) => b.rate - a.rate).slice(0, 3);
  D.hot = 0;
  if (has) { const sh = shortage(p); for (const e of A.arts.values()) { if (e.rate < 0.5) continue; const st = stock.items.get(e.k), q = st ? Math.max(0, st.q) : 0, need = (sh.get(e.k) || {}).need || 0; if (need || q <= e.rate * Math.max(1, S.anLead)) D.hot++; } }
  D.retQ = round(RET.reduce((a, r) => a + r.q, 0)); D.retPav = new Set(RET.map(r => r.pav)).size;
  return D;
}
function homeTips(D) {
  const T = [];
  if (D.short) T.push({sv: 'bad', b: `Не хватает товара для ${cnt(D.short, W.ship)}`, d: `Нужно купить ${fmt(round(D.shortQ))} шт. ${inPav(D.pavs.length)}.`, act: '<button class="btn primary" type="button" data-go="buy">К закупке</button>'});
  if (D.unsent.length) { const pv = D.unsent[0]; T.push({sv: 'warn', b: `Заказ не отправлен: ${D.unsent.length === 1 ? pavLabel(pv.pav).toLowerCase() : cnt(D.unsent.length, W.pav)}`, d: D.unsent.slice(0, 4).map(x => `${x.pav || 'без павильона'} · ${fmt(x.order)} шт.`).join(', ') + (D.unsent.length > 4 ? '…' : ''), act: `<button class="btn" type="button" data-order-pav="${esc(pv.pav)}"><svg class="ic"><use href="#i-doc"/></svg>Заказ ${esc(pv.pav || '')}</button>`}); }
