function applyImport() {
  const s = extractAll();
  if (!s.lines.length) return;
  const src = IMP.files.map(f => f.name).join(', ');
  const t = IMP.target, mode = IMP.mode;
  const hdr = IMP.m.header >= 0 ? (curRows()[IMP.m.header] || []).slice(0, 12).map(v => String(v).slice(0, 30)) : null;
  diag('import', `${t} ${src}`.slice(0, 200), {mode, m: IMP.m, hdr, lines: s.lines.length, uniq: s.uniq, sum: s.sum, noArt: s.noArt, badQty: s.badQty, sci: s.sci, mismatch: s.mismatch});
  if (t === 'history') {
    const byDay = new Map();
    let canc = 0;
    for (const l of s.lines) {
      if (!l.dt) continue;
      if (l.st && CANCEL_RX.test(l.st)) { canc++; continue; }
      const day = byDay.get(l.dt) || byDay.set(l.dt, new Map()).get(l.dt), k = normKey(l.a);
      const e = day.get(k); if (e) e[1] = round(e[1] + l.q); else day.set(k, [l.a, l.q]);
    }
    const isos = [...byDay.keys()].sort();
    isos.forEach((iso, i) => {
      const day = byDay.get(iso), doc = {date: isoRu(iso), at: new Date(iso + 'T12:00:00').getTime(), src: 'ozon', file: src, items: [...day.values()]};
      saveDoc('hist/d' + iso, () => doc, 80 + i * 150);
      if (HIST) HIST.set(iso, new Map([...day].map(([k, v]) => [k, v])));
    });
    const tot = round(isos.reduce((a, iso) => a + [...byDay.get(iso).values()].reduce((b, v) => b + v[1], 0), 0));
    log(`Загружена история продаж «${src}»: ${cnt(isos.length, W.day)}${isos.length ? ` (${isoRu(isos[0])} — ${isoRu(isos[isos.length - 1])})` : ''}, ${fmt(tot)} шт.${canc ? `, отменённых не считали: ${fmt(canc)}` : ''}`);
    toast(`История загружена: ${cnt(isos.length, W.day)}, ${fmt(tot)} шт.`);
    setTab('an');
    if (HIST === null) setTimeout(loadHist, 80 + isos.length * 150 + 800);
  } else if (t === 'receipt') {
    for (const l of s.lines) draft.put({a: l.a, q: l.q, n: l.n, t: tick()});
    toast(`В список пересчёта добавлено: ${cnt(s.uniq, W.art)}, ${fmt(s.sum)} шт.`);
  } else if (t === 'stock') {
    const b = [stock.items.size, stock.total()];
    if (mode === 'replace') stock.clear();
    for (const l of s.lines) stockAdd(l.a, l.q, l.n);
    if (mode === 'replace') log(`Полный пересчёт из «${src}»: ${cnt(stock.items.size, W.art)}, ${fmt(stock.total())} шт. (было ${fmt(b[0])} арт., ${fmt(b[1])} шт.)`);
    else log(`Приход из «${src}»: +${fmt(s.sum)} шт., ${cnt(s.uniq, W.art)}`);
    toast(mode === 'replace' ? 'Склад заменён данными из файла' : `На склад добавлено ${fmt(s.sum)} шт.`);
  } else {
    const pdf = IMP.files.find(f => f.info);
    loadList(s.lines, {file: src, date: pdf ? pdf.info.date : '', expected: IMP.files.every(f => f.info && f.info.expected) ? IMP.files.reduce((a, f) => a + f.info.expected, 0) : 0});
    const files = IMP.files, byFile = s.byFile;
    if (files.some(f => f.pdf) && IMP.m.header === 0) queuePhotos(files, byFile);
    else files.forEach(f => { if (f.pdf) f.pdf.destroy().catch(() => {}); });
    ui.dayF = 'all'; ui.dayLimit = 300; setTab('day');
  }
  if (t !== 'orders') IMP.files.forEach(f => { if (f.pdf) f.pdf.destroy().catch(() => {}); });
  IMP.files = [];
  closeModal('#imp'); render();
}

/* ---------- export ---------- */
const safeName = s => s.replace(/[\\/:*?"<>|]+/g, ' ').replace(/\s+/g, ' ').trim();
const today = () => new Date().toLocaleDateString('ru-RU');
function csvCell(v) {
  if (typeof v === 'number') return qv(v);
  v = String(v ?? '');
  if (/^0\d+$/.test(v)) return `="${v}"`;
  return /[;"\n\r]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v;
}
async function saveTable(base, sheets) {
  let data, ext;
  try {
    await ensureXLSX();
    const wb = XLSX.utils.book_new();
    for (const s of sheets) { const ws = XLSX.utils.aoa_to_sheet(s.rows); ws['!cols'] = s.cols.map(w => ({wch: w})); XLSX.utils.book_append_sheet(wb, ws, s.name.slice(0, 31)); }
    data = new Uint8Array(XLSX.write(wb, {bookType: 'xlsx', type: 'array', compression: true})); ext = 'xlsx';
  } catch {
    data = '﻿' + sheets[0].rows.map(r => r.map(csvCell).join(';')).join('\r\n'); ext = 'csv';
  }
  const name = `${safeName(base)}.${ext}`;
  if (DL) {
    try { await DL.save({filename: name, data}); toast('Файл сохранён: ' + name); diag('export', name, 'saved'); }
    catch (e) {
      const c = e && e.code;
      diag('export', name, {code: c || '', msg: String((e && e.message) || '').slice(0, 200)});
      if (c === 'declined') return;
      toast(c === 'rate_limited' ? 'Подождите пару секунд и нажмите ещё раз' : 'Не получилось сохранить файл. Нажмите «Копировать» и вставьте список в Excel.');
    }
    return;
  }
  const url = URL.createObjectURL(new Blob([data], {type: ext === 'xlsx' ? 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' : 'text/csv;charset=utf-8'}));
  const a = document.createElement('a'); a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 5000);
  diag('export', name, inViewer ? 'link-in-viewer' : 'link');
  if (inViewer) toast('Если файл не скачался, нажмите «Копировать» и вставьте список в Excel.');
}
function exportStock() {
  const items = [...stock.items.values()].sort((a, b) => coll.compare(a.a, b.a));
  if (!items.length) { toast('Склад пуст — выгружать нечего'); return; }
  saveTable(`Остатки ${today()}`, [{name: 'Остатки', cols: [20, 50, 12], rows: [['Артикул', 'Наименование', 'Остаток, шт.'], ...items.map(it => [it.a, it.n, it.q])]}]);
}
async function copyText(text, ok) {
  try { await navigator.clipboard.writeText(text); toast(ok); diag('copy', 'ok', text.length); }
  catch { diag('copy', 'fallback', text.length); $('#cpyText').value = text; showModal('#cpy'); const ta = $('#cpyText'); ta.focus(); ta.select(); }
}
/* ---------- the day: orders, stock, purchases ---------- */
function stockAdd(a, q, n) {
  a = String(a ?? '').trim();
  const k = akey(a); if (!k) return null;
  const c = stock.items.get(k);
  if (c) { const was = c.q; c.q = round(c.q + q); if (!c.n && n) c.n = n; if (was <= 0 && c.q > 0) c.in = Date.now(); stock.touch(k); return k; }
  return stock.put({a, q: round(q), n: n || '', t: tick(), in: q > 0 ? Date.now() : 0, out: 0});
}
function stockTake(k, q) { const c = stock.items.get(k); if (!c) return; c.q = round(c.q - q); c.out = Date.now(); stock.touch(k); }
const byAge = (a, b) => (a.d - b.d) || (a.i - b.i);

// what the stock can give right now: older shipments first
function plan() {
  const free = new Map();
  for (const [k, it] of stock.items) if (it.q > 0) free.set(k, it.q);
  const open = [];
  for (const [k, ln] of lines.items) { const need = round(ln.q - ln.got - wsum(ln)); if (need > 0) open.push({k, ln, need}); }
  open.sort((a, b) => byAge(a.ln, b.ln));
  const res = new Map();
  for (const {k, ln, need} of open) {
    const ak = akey(ln.a), f = free.get(ak) || 0, take = Math.min(f, need);
    if (take > 0) free.set(ak, round(f - take));
    res.set(k, {take, short: round(need - take)});
  }
  return res;
}
function lineState(k, ln, p) {
  if (ln.got >= ln.q) return 'ready';
  const r = p.get(k);
  if (r && r.short > 0) return 'short';
  if (wsum(ln) > 0) return 'wait';
  return r && r.take > 0 ? 'stock' : 'ready';
}
const RANK = {short: 0, wait: 1, stock: 2, ready: 3};
function shipsOf(p) {
  const ships = new Map();
  for (const [k, ln] of lines.items) {
    const st = lineState(k, ln, p), sid = ln.s || k;
    let e = ships.get(sid);
    if (!e) ships.set(sid, e = {sid, lines: [], state: 'ready', d: ln.d});
    e.lines.push({k, ln, st});
    if (RANK[st] < RANK[e.state]) e.state = st;
    e.d = Math.min(e.d, ln.d);
  }
  return ships;
}
function shortage(p) {
  const m = new Map();
  for (const [k, r] of p) {
    if (r.short <= 0) continue;
    const ln = lines.items.get(k), ak = akey(ln.a);
    let e = m.get(ak);
    if (!e) m.set(ak, e = {ak, a: ln.a, n: ln.n, need: 0});
    e.need = round(e.need + r.short);
    if (!e.n && ln.n) e.n = ln.n;
  }
  return m;
}
// what to buy; models and pavilions taken out with × are left out unless «all»
function buyRows(p, all) {
  const sh = shortage(p), rows = [];
  const keys = new Set(sh.keys());
  for (const [k, e] of PO) if (e.add) keys.add(k);
  for (const ak of keys) {
    const e = sh.get(ak), po = PO.get(ak);
    const a = canonArt(e ? e.a : po.a);
    const n = (e && e.n) || (po && po.n) || (stock.items.get(ak) || {}).n || '';
    const need = e ? e.need : 0;
    const order = po && po.q != null ? po.q : need;
    const pa = parseArt(a), skip = SKIP.p.has(pa.pav) ? 'p' : SKIP.m.has(pa.mkey) ? 'm' : '';
    if (skip && !all) continue;
    rows.push({ak, a, n, need, order, add: !!(po && po.add), ...pa, skip});
  }
  return rows;
}
function groupModels(rows) {
  const pavs = new Map();
  for (const r of rows) {
    let pv = pavs.get(r.pav); if (!pv) pavs.set(r.pav, pv = {pav: r.pav, models: new Map(), need: 0, order: 0});
    let m = pv.models.get(r.mkey); if (!m) pv.models.set(r.mkey, m = {mkey: r.mkey, model: r.model, n: r.n, rows: [], moved: r.movedFrom || ''});
    if (!m.n && r.n) m.n = r.n;
    m.rows.push(r); pv.need = round(pv.need + r.need); pv.order = round(pv.order + r.order);
  }
  const list = [...pavs.values()].sort((a, b) => byPav(a.pav, b.pav));
  for (const pv of list) { pv.list = [...pv.models.values()].sort((a, b) => coll.compare(a.model, b.model)); pv.list.forEach(m => m.rows.sort((a, b) => bySize(a.size, b.size))); }
  return list;
}

/* ---------- twins: one coat sold by two shops under different articles ---------- */
// colours from the name (Russian) or the article (English or transliterated): a black and a white coat are never twins
const COLOR_RU = ['черн', 'бел', 'беж', 'сер', 'корич', 'шокол', 'молоч', 'крем', 'айвор', 'трюфел', 'зебр', 'леопар', 'тигр', 'голуб', 'син', 'розов', 'пудр', 'красн', 'бордо', 'вишн', 'зелен', 'олив', 'хаки', 'мят', 'желт', 'горч', 'оранж', 'персик', 'фиолет', 'лилов', 'сирен', 'графит', 'антрац', 'капуч', 'мокк', 'карамел', 'песоч', 'золот', 'серебр', 'изумр'];
const COLOR_LAT = [['BLACK', 'черн'], ['CHERN', 'черн'], ['WHITE', 'бел'], ['BELA', 'бел'], ['BELY', 'бел'], ['BEIG', 'беж'], ['BEZH', 'беж'], ['GREY', 'сер'], ['GRAY', 'сер'], ['SERA', 'сер'], ['SERY', 'сер'], ['BROWN', 'корич'], ['KORICH', 'корич'], ['CHOCO', 'шокол'], ['SHOKO', 'шокол'], ['MILK', 'молоч'], ['MOLOCH', 'молоч'], ['CREAM', 'крем'], ['KREM', 'крем'], ['IVOR', 'айвор'], ['TRUF', 'трюфел'], ['ZEBR', 'зебр'], ['LEOP', 'леопар'], ['BLUE', 'голуб'], ['GOLUB', 'голуб'], ['PINK', 'розов'], ['ROZOV', 'розов'], ['PUDR', 'пудр'], ['RED', 'красн'], ['KRASN', 'красн'], ['BORDO', 'бордо'], ['GREEN', 'зелен'], ['ZELEN', 'зелен'], ['OLIV', 'олив'], ['KHAKI', 'хаки'], ['HAKI', 'хаки'], ['MINT', 'мят'], ['GRAFIT', 'графит'], ['CAMEL', 'карамел'], ['GOLD', 'золот'], ['SILV', 'серебр']];
const colorOf = (t, lat) => { if (lat) { for (const [p, c] of COLOR_LAT) if (t.startsWith(p)) return c; return ''; } for (const c of COLOR_RU) if (t.startsWith(c)) return c; return ''; };
// every model the program knows now, by the article as written
function modelIndex() {
  const M = new Map();
  const add = (a, n, q) => {
    const r = parseRaw(a); if (!r.mkey) return;
    let m = M.get(r.mkey);
    if (!m) M.set(r.mkey, m = {mk: r.mkey, a: String(a).trim(), model: r.model, pav: r.pav, rp: r.rp, n: '', sizes: new Set(), q: 0});
    if (!m.n && n) m.n = n;
    if (r.size) m.sizes.add(latinUp(r.size));
    m.q += Math.max(0, q || 0);
  };
  for (const ln of lines.items.values()) add(ln.a, ln.n, ln.q);
  for (const it of stock.items.values()) add(it.a, it.n, it.q);
  for (const e of PO.values()) add(e.a, e.n, 0);
  for (const x of going()) for (const l of x.lines) add(l.a, l.n, 0);
  return M;
}
// words of the name and parts of the article, without sizes, barcodes, the price and the shop's «"2"» mark
function twinFeat(m) {
  const toks = new Set(), colors = new Set();
  let n = String(m.n || '').toLowerCase().replace(/ё/g, 'е');
  const tag = (n.match(/^\s*["«'“„]\s*(\d{1,2})\s*["»'”“]/) || [])[1] || '';
  n = n.replace(/^\s*["«'“„]\s*\d{1,2}\s*["»'”“]/, ' ').replace(/\d{11,14}/g, ' ');
  for (const w of n.split(/[^a-zа-я0-9]+/)) {
    if (!w || (w.length < 2 && !/\d/.test(w))) continue;
    const u = latinUp(w);
    if (SIZE_RX.test(u) && (/[A-Z]/.test(u) || m.sizes.has(u) || (+u >= 38 && +u <= 64))) continue;
    const lat = /^[a-z]/.test(w), c = colorOf(lat ? w.toUpperCase() : w, lat); if (c) colors.add(c);
    toks.add(u);
  }
  const parts = shortModel(m.model).split('-').map(x => latinUp(x.trim())).filter(Boolean);
  let sig = '';
  for (const t of parts) {
    if (m.rp && t === String(m.rp)) continue;
    const c = colorOf(t, true); if (c) colors.add(c);
    toks.add(t); sig += (t.match(/\d+/g) || []).join('');
  }
  return {toks, colors, tag, sig};
}
const pairKey = (a, b) => a < b ? a + '|' + b : b + '|' + a;
let twinCache = {sig: '', list: [], M: null}, MODV = 0;   // MODV: bumped on every change of twins
// pairs worth a look: same pavilion, similar name and article; each model in one pair at most
function twinSuggest() {
  const sig = [lines.items.size, stock.items.size, PO.size, MODV, TWIN.size, NOTWIN.size, going().length, S.pav, S.latin, S.punct, S.zeros, DAYM.at].join('|');
  if (twinCache.sig === sig) return twinCache;
  const M = modelIndex(), roots = [...M.values()].filter(m => !TWIN.has(m.mk));
  const F = new Map(roots.map(m => [m.mk, twinFeat(m)])), df = new Map();
  for (const f of F.values()) for (const t of f.toks) df.set(t, (df.get(t) || 0) + 1);
  const N = Math.max(2, roots.length), w = t => Math.log(1 + N / (df.get(t) || 1));
  // «А3» and «А03» written by two shops are one pavilion here too
  const byPavM = new Map(), pk = pav => pav.replace(/^([^\d]*)0+(?=\d)/, '$1');
  for (const m of roots) { const k = pk(m.pav); (byPavM.get(k) || byPavM.set(k, []).get(k)).push(m); }
  const cand = [];
  for (const [pav, ms] of byPavM) {
    if (!pav || ms.length < 2) continue;
    for (let i = 0; i < ms.length; i++) for (let j = i + 1; j < ms.length; j++) {
      const a = ms[i], b = ms[j], fa = F.get(a.mk), fb = F.get(b.mk);
      if (NOTWIN.has(pairKey(a.mk, b.mk))) continue;
      if (fa.colors.size && fb.colors.size && ![...fa.colors].some(c => fb.colors.has(c))) continue;
      let both = 0, any = 0;
      for (const t of fa.toks) { const x = w(t); any += x; if (fb.toks.has(t)) both += x; }
      for (const t of fb.toks) if (!fa.toks.has(t)) any += w(t);
      let sc = any ? both / any : 0;
      if (fa.sig && fb.sig) sc = fa.sig === fb.sig ? Math.min(1, sc + 0.2) : sc * 0.5;
      if (fa.tag && fb.tag && fa.tag === fb.tag) sc *= 0.7;
      if (sc < 0.5) continue;
      const main = (b.q > a.q || (b.q === a.q && !purl(a.mk) && purl(b.mk))) ? b : a, other = main === a ? b : a;
      cand.push({main, other, sc, sure: sc >= 0.8 && (!fa.sig || fa.sig === fb.sig)});
    }
  }
  cand.sort((x, y) => y.sc - x.sc);
  const used = new Set(), list = [];
  for (const c of cand) { if (used.has(c.main.mk) || used.has(c.other.mk)) continue; used.add(c.main.mk); used.add(c.other.mk); list.push(c); }
  twinCache = {sig, list, M, F, w};
  return twinCache;
}
// models of the same pavilion ranked by likeness, for joining by hand
function twinRank(mk) {
  const {M} = twinSuggest(), me = M.get(mk); if (!me) return [];
  const fm = twinFeat(me), out = [];
  for (const m of M.values()) {
    if (m.mk === mk || TWIN.has(m.mk) || m.pav.replace(/^([^\d]*)0+(?=\d)/, '$1') !== me.pav.replace(/^([^\d]*)0+(?=\d)/, '$1')) continue;
    const f = twinFeat(m); let both = 0, any = 0;
    for (const t of fm.toks) { any++; if (f.toks.has(t)) both++; }
    for (const t of f.toks) if (!fm.toks.has(t)) any++;
    out.push({m, sc: any ? both / any : 0});
  }
  return out.sort((a, b) => b.sc - a.sc);
}
// «other» becomes a twin of «main»: from now on both count as main's article, size by size
function joinTwins(pairs) {
  for (const [main, other] of pairs) {
    const root = TWIN.get(main.mk) || {to: main.mk, a: main.a};
    if (root.to === other.mk) continue;
    TWIN.set(other.mk, {to: root.to, a: root.a});
    for (const t of TWIN.values()) if (t.to === other.mk) { t.to = root.to; t.a = root.a; }
    if (MOVE.has(other.mk)) { if (!MOVE.has(root.to)) MOVE.set(root.to, MOVE.get(other.mk)); MOVE.delete(other.mk); }
    if (SKIP.m.has(other.mk)) { SKIP.m.delete(other.mk); SKIP.m.add(root.to); }
    NOTWIN.delete(pairKey(main.mk, other.mk));
  }
  MODV++;
  saveMeta('meta/models'); saveMeta('meta/po');
  rekeyAll(true);
}
function splitTwin(mk) {
  if (!TWIN.delete(mk)) return;
  MODV++;
  saveMeta('meta/models');
  rekeyAll(true);
}

function loadList(inLines, info) {
  const day = tick();
  const incoming = new Set(inLines.map(l => l.s ? l.s + '|' + akey(l.a) : ''));
  // shipments given out earlier and missing from the new list have left the warehouse
  for (const [k, ln] of [...lines.items]) if (ln.got >= ln.q && !incoming.has(k)) lines.remove(k);
  let added = 0, dup = 0;
  inLines.forEach((l, idx) => {
    const k = l.s ? l.s + '|' + akey(l.a) : null;
    if (k && lines.items.has(k)) {
      const ex = lines.items.get(k);
      if (ex.d === day) ex.q = round(ex.q + l.q); else dup++;
      lines.touch(k); return;
    }
    lines.put({s: l.s, a: l.a, n: l.n, q: l.q, got: 0, w: {}, d: day, i: day + idx});
    added++;
  });
  const ships = new Set(inLines.map(l => l.s).filter(Boolean)).size;
  DAYM = {date: info.date || new Date().toLocaleDateString('ru-RU'), file: info.file, at: day, expected: info.expected || 0, ships};
  saveMeta('meta/day');
  // sales history for later analysis
  const agg = new Map();
  for (const l of inLines) { const k = normKey(l.a); const e = agg.get(k); if (e) e[1] = round(e[1] + l.q); else agg.set(k, [l.a, l.q]); }
  const [dd, mm, yy] = DAYM.date.split('.');
  const hid = yy ? `d${yy}-${mm}-${dd}` : 'd' + new Date().toISOString().slice(0, 10);
  const hist = {date: DAYM.date, file: info.file, at: day, ships, items: [...agg.values()]};
  saveDoc('hist/' + hid, () => hist, 50);
  if (HIST) { const day = new Map(); for (const [a, q] of agg.values()) day.set(normKey(a), [a, q]); HIST.set(hid.slice(1), day); }
  const old = [...lines.items.values()].filter(ln => ln.d < day && ln.got < ln.q).length;
  log(`Лист подбора ${DAYM.date}: ${cnt(ships || inLines.length, ships ? W.ship : W.row)}, новых строк ${fmt(added)}${dup ? `, уже были ${fmt(dup)}` : ''}${old ? `; с прошлых дней ждут ${fmt(old)}` : ''}`);
  diag('list', DAYM.date, {added, dup, ships, expected: info.expected || 0, old, total: lines.items.size, stock: stock.items.size});
  toast(`Лист загружен: ${cnt(added, W.row)}${dup ? `, ${fmt(dup)} уже были в программе` : ''}`);
}

function commit() {
  const snap = takeSnap();
  const p = plan(), now = Date.now();
  let taken = 0; const takenShips = new Set();
  for (const [k, r] of p) {
    if (r.take <= 0) continue;
    const ln = lines.items.get(k);
    ln.got = round(ln.got + r.take); lines.touch(k);
    stockTake(akey(ln.a), r.take);
    taken = round(taken + r.take); takenShips.add(ln.s || k);
  }
  // short lines by article, oldest first
  const shortBy = new Map();
  for (const [k, r] of p) if (r.short > 0) { const ln = lines.items.get(k), ak = akey(ln.a); (shortBy.get(ak) || shortBy.set(ak, []).get(ak)).push({k, ln, r}); }
  for (const arr of shortBy.values()) arr.sort((a, b) => byAge(a.ln, b.ln));
  const rows = buyRows(p).filter(r => r.order > 0);
  const pavs = groupModels(rows);
  const made = [];
  for (const pv of pavs) {
    const id = newId('P');
    const pur = {id, at: now, pav: pv.pav, st: 'go', lines: [], extra: [], rep: null, doneAt: 0};
    for (const m of pv.list) for (const r of m.rows) {
      const pl = {a: r.a, n: r.n, q: r.order, need: 0, c: 0, k: r.ak};
      let avail = r.order;
      for (const x of shortBy.get(r.ak) || []) {
        if (avail <= 0) break;
        if (x.r.short <= 0) continue;
        const give = Math.min(avail, x.r.short);
        x.ln.w[id] = round((x.ln.w[id] || 0) + give); lines.touch(x.k);
        x.r.short = round(x.r.short - give); avail = round(avail - give); pl.need = round(pl.need + give);
      }
      pur.lines.push(pl);
    }
    PUR.set(id, pur); savePur(id, 50); made.push(pur);
  }
  PO = new Map(); SENT = new Map(); SKIP.m = new Set(); SKIP.p = new Set(); saveMeta('meta/po');
  const ordered = made.reduce((s, x) => s + x.lines.reduce((a, l) => a + l.q, 0), 0);
  const forOrders = made.reduce((s, x) => s + x.lines.reduce((a, l) => a + l.need, 0), 0);
  if (taken) log(`Списано со склада под отправления: ${fmt(taken)} шт., ${cnt(takenShips.size, W.ship)}`);
  if (made.length) log(`Закупка у поставщиков: ${fmt(ordered)} шт. ${inPav(made.length)} (${made.map(x => x.pav || 'без павильона').join(', ')}); под заказы ${fmt(forOrders)}, на склад ${fmt(round(ordered - forOrders))}`);
  diag('commit', '', {taken, ships: takenShips.size, pur: made.map(x => [x.pav, round(x.lines.reduce((a, l) => a + l.q, 0)), round(x.lines.reduce((a, l) => a + l.need, 0)), x.lines.length])});
  toastUndo(made.length ? `Закупка оформлена: ${fmt(ordered)} шт.${taken ? `, со склада списано ${fmt(taken)} шт.` : ''}` : `Со склада списано ${fmt(taken)} шт.`, snap, made.length ? 'оформление закупки' : 'списание со склада');
  celebrate(TAP.x, TAP.y);
}

function recvPreview(pur) {
  const want = new Map();
  for (const ln of lines.items.values()) { const w = ln.w[pur.id]; if (w) { const ak = akey(ln.a); want.set(ak, round((want.get(ak) || 0) + w)); } }
  let toOrd = 0, toStock = 0, unc = 0, ord = 0, got = 0;
  const diff = [];
  for (const l of pur.lines) {
    ord += l.q; got += l.c;
    const w = want.get(l.k) || 0, give = Math.min(l.c, w);
    toOrd += give; toStock += l.c - give; unc += w - give;
    if (l.c !== l.q) diff.push(l);
  }
  for (const e of pur.extra) if (e.to === 'stock') toStock += e.q;
  return {ord: round(ord), got: round(got), toOrd: round(toOrd), toStock: round(toStock), unc: round(unc), diff};
}
// bulk: part of «принять без проверки» — the caller keeps one undo for all bags
function receive(pur, bulk) {
  const snap = bulk ? null : takeSnap();
  const now = Date.now();
  const rep = {ord: 0, got: 0, toOrd: 0, toStock: 0, rows: [], extra: pur.extra.map(e => [e.a, e.q, e.to]), unc: []};
  if (bulk) rep.asis = 1;
  const waitBy = new Map();
  for (const [k, ln] of lines.items) if (ln.w[pur.id]) { const ak = akey(ln.a); (waitBy.get(ak) || waitBy.set(ak, []).get(ak)).push({k, ln}); }
  for (const arr of waitBy.values()) arr.sort((a, b) => byAge(a.ln, b.ln));
  for (const l of pur.lines) {
    let A = l.c;
    rep.ord = round(rep.ord + l.q); rep.got = round(rep.got + l.c);
    rep.rows.push([l.a, l.q, l.c]);
    for (const {k, ln} of waitBy.get(l.k) || []) {
      const want = ln.w[pur.id] || 0, give = Math.min(A, want);
      if (give > 0) { ln.got = round(ln.got + give); A = round(A - give); rep.toOrd = round(rep.toOrd + give); }
      if (want - give > 0) rep.unc.push(ln.s || ln.a);
      delete ln.w[pur.id]; lines.touch(k);
    }
    waitBy.delete(l.k);
    if (A > 0) { stockAdd(l.a, A, l.n); rep.toStock = round(rep.toStock + A); }
  }
  for (const arr of waitBy.values()) for (const {k, ln} of arr) { rep.unc.push(ln.s || ln.a); delete ln.w[pur.id]; lines.touch(k); }
  for (const e of pur.extra) {
    if (e.to === 'stock') { stockAdd(e.a, e.q, ''); rep.toStock = round(rep.toStock + e.q); }
    else { RET.push({a: e.a, q: e.q, pav: pur.pav, at: now}); saveMeta('meta/returns'); }
  }
  pur.st = 'done'; pur.doneAt = now; pur.rep = rep; savePur(pur.id, 50);
  const ss = SUPSTAT.get(pur.pav) || {n: 0, ord: 0, got: 0, short: 0, extra: 0, last: 0};
  ss.n++; ss.ord = round(ss.ord + rep.ord); ss.got = round(ss.got + rep.got); ss.last = now;
  for (const l of pur.lines) { ss.short = round(ss.short + Math.max(0, l.q - l.c)); ss.extra = round(ss.extra + Math.max(0, l.c - l.q)); }
  for (const e of pur.extra) ss.extra = round(ss.extra + e.q);
  SUPSTAT.set(pur.pav, ss); saveMeta('meta/supstats');
  const miss = round(rep.ord - rep.got);
  log(`Приёмка ${pur.pav || 'без павильона'} от ${dm(pur.at)}${bulk ? ' без пересчёта' : ''}: заказано ${fmt(rep.ord)}, пришло ${fmt(rep.got)}${pur.extra.length ? `, не из заказа ${fmt(pur.extra.reduce((s, e) => s + e.q, 0))}` : ''}; в отправления ${fmt(rep.toOrd)}, на склад ${fmt(rep.toStock)}${rep.unc.length ? `; снова не хватает: ${cnt(rep.unc.length, W.ship)}` : ''}`);
  diag('receive', pur.pav, {id: pur.id, ord: rep.ord, got: rep.got, toOrd: rep.toOrd, toStock: rep.toStock, unc: rep.unc.length, extra: pur.extra.length, lines: pur.lines.length, asis: !!bulk});
  if (bulk) return rep;
  toastUndo(miss > 0 ? `Приёмка проведена. Не доложили ${fmt(miss)} шт.` : 'Приёмка проведена', snap, `приёмка ${pur.pav || 'без павильона'}`, () => { if (ui.tab === 'recv') ui.recvId = pur.id; });
  celebrate(TAP.x, TAP.y, miss > 0 ? 50 : 130);
}
// «принять без проверки»: every size came as ordered, no counting
function askAsIs(id, box) {
  const purs = (id === '*' ? going() : [PUR.get(id)]).filter(x => x && x.st === 'go');
  if (!purs.length) return;
  const q = round(purs.reduce((s, x) => s + x.lines.reduce((a, l) => a + l.q, 0), 0));
  const one = purs.length === 1;
  const html = `${one ? `Принять мешок <b>${esc(purs[0].pav || 'без павильона')}</b>` : `Принять <b>все ${cnt(purs.length, ['мешок', 'мешка', 'мешков'])}</b>`} без пересчёта? Программа посчитает, что пришло ровно то, что заказано: <b>${fmt(q)} шт.</b> Товар сразу разложится по отправлениям, остаток пойдёт на склад. Если потом чего-то не окажется, поправьте склад пересчётом.`;
  confirmIn(box, html, one ? 'Принять без проверки' : 'Принять все без проверки', () => {
    const snap = takeSnap();
    let got = 0, toOrd = 0, toStock = 0;
    for (const pur of purs) { pur.lines.forEach(l => { l.c = l.q; }); const r = receive(pur, true); got += r.got; toOrd += r.toOrd; toStock += r.toStock; }
    toastUndo(`Принято без пересчёта: ${fmt(round(got))} шт. В отправления ${fmt(round(toOrd))}, на склад ${fmt(round(toStock))}.`, snap, one ? `приёмка ${purs[0].pav || 'без павильона'}` : 'приёмка всех мешков');
    celebrate(TAP.x, TAP.y);
  });
}
function cancelPurchase(id) {
  const pur = PUR.get(id); if (!pur) return;
  for (const [k, ln] of lines.items) if (ln.w[id]) { delete ln.w[id]; lines.touch(k); }
  PUR.delete(id); savePur(id, 50);
  log(`Отменена закупка ${pur.pav || 'без павильона'} от ${when(pur.at)}`);
}
function cancelShipment(sid) {
  let back = 0;
  for (const [k, ln] of [...lines.items]) {
    if ((ln.s || k) !== sid) continue;
    if (ln.got > 0) { stockAdd(ln.a, ln.got, ln.n); back = round(back + ln.got); }
    lines.remove(k);
  }
  log(`Убрано отправление ${sid}${back ? `: ${fmt(back)} шт. вернулись на склад` : ''}`);
}

/* ---------- sales analysis ---------- */
let HIST = null, histBusy = false;
const isoOf = d => `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
const isoToday = () => isoOf(new Date());
const isoAdd = (iso, n) => { const d = new Date(iso + 'T12:00:00'); d.setDate(d.getDate() + n); return isoOf(d); };
const isoDiff = (a, b) => Math.round((new Date(b + 'T12:00:00') - new Date(a + 'T12:00:00')) / DAYMS);
const isoRu = iso => iso.split('-').reverse().join('.');
const canonSize = sz => sizeShow(szNorm(sz)) || '—';
function parseDay(v) {
  const t = String(v ?? '').trim();
  let m = t.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (m) return `${m[1]}-${p2(m[2])}-${p2(m[3])}`;
  m = t.match(/^(\d{1,2})[./](\d{1,2})[./](\d{2,4})/);
  if (m) { let y = +m[3]; if (y < 100) y += 2000; return `${y}-${p2(m[2])}-${p2(m[1])}`; }
  if (/^\d{5}(\.\d+)?$/.test(t)) { const n = parseFloat(t); if (n > 30000 && n < 80000) return new Date(Math.round((n - 25569) * DAYMS)).toISOString().slice(0, 10); }
  return null;
}
async function loadHist() {
  if (!Backend || histBusy || !allReady()) return;
