# Скопируйте в .env и заполните. Файл .env не попадает в репозиторий.
# Запуск с файлом настроек: node --env-file=.env server/server.js

PORT=8080

# Токен Telegram-бота от @BotFather: проверка заявок из Telegram и отправка их менеджерам.
TELEGRAM_BOT_TOKEN=

# Токен бота MAX: проверка заявок из MAX.
MAX_BOT_TOKEN=

# Куда присылать заявки: id чатов в Telegram через запятую (менеджер, общий чат).
# Свой id можно узнать у бота @userinfobot; менеджер должен один раз написать боту /start.
MANAGER_CHAT_IDS=

# Кто может добавлять машины через бота: id в Telegram через запятую (Владимир, Андрей).
ADMIN_IDS=

# Ссылка на мини-приложение (https://t.me/<бот>/<приложение>) — бот дописывает её к опубликованным машинам.
APP_LINK=

# 1 — принимать заявки только из Telegram и MAX с проверенной подписью (без сайта).
REQUIRE_INIT_DATA=0

# 1 — сервер стоит за nginx или Caddy: адрес клиента брать из X-Forwarded-For.
TRUST_PROXY=0

# Если приложение и сервер на разных адресах: адреса приложения через запятую.
ALLOWED_ORIGINS=

# Журнал заявок (по умолчанию data-private/leads.jsonl).
LEADS_LOG=

# Каталог и фото машин вне репозитория (на сервере их ставит deploy/install.sh).
CARS_FILE=
PHOTOS_DIR=

# --- Ролики ---
# После публикации машины бот делает 3 вертикальных ролика (нужны ffmpeg и RHVoice, см. README)
# и присылает их на одобрение. Одобренные выходят по одному в каждое время из CLIP_TIMES (МСК).
# 0 — выключить ролики.
CLIPS=1
CLIP_TIMES=10:40,15:20,19:40

# Telegram-канал для роликов: @имя_канала или -100…; бот должен быть админом канала.
CLIP_TG_CHANNEL=

# VK: id сообщества (число) и ключ доступа администратора сообщества с правами video и wall.
# Ключ сообщества не подойдёт: загрузка видео в VK работает только с ключом пользователя.
VK_GROUP_ID=
VK_TOKEN=

# Телефон на последнем кадре ролика.
PHONE_LABEL=+7 928 333-95-70

# Озвучка Qwen3-TTS вместо RHVoice: адрес сервиса tts/qwen_tts_server.py (см. README, «Живой голос»).
# Пусто — озвучивает RHVoice.
TTS_URL=

# Если сервер не видит api.telegram.org (бывает у дата-центров в России): адрес посредника за границей,
# который настраивает deploy/tg-relay.sh. Пусто — напрямую.
TELEGRAM_API_BASE=

# --- Нейросеть для разбора объявлений и фото ---
# Kimi (platform.moonshot.ai) или любая модель с API как у OpenAI. Настраивается командой ando → 9.
# Пусто — обычный разбор. Телефоны, почта и ссылки вырезаются из текста до отправки.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 0 — не отправлять фото (по фото определяются только марка, модель, поколение, кузов и цвет, если их нет в тексте).
LLM_VISION=1
