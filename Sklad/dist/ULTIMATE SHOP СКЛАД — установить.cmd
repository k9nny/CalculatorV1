    kind: 'db',
    set: (p, data) => retry(() => db.doc(p).set(data)),
    del: p => retry(() => db.doc(p).delete()),
    async get(p) { const d = await retry(() => db.doc(p).get()); return d.exists ? d.data() : null; },
    watchColl(name, cb) { db.collection(name).onSnapshot(s => cb(docs(s), s.metadata.fromCache), fail); },
    watchQuery(name, q, cb) {
      let r = db.collection(name);
      if (q.where) r = r.where(...q.where);
      if (q.order) r = r.orderBy(...q.order);
      if (q.limit) r = r.limit(q.limit);
      r.onSnapshot(s => cb(docs(s), s.metadata.fromCache), fail);
    },
    watchDoc(p, cb) { db.doc(p).onSnapshot(d => cb(d.exists ? d.data() : null), fail); },
    async query(name, q) {
