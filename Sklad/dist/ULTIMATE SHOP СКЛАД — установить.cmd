/* ---------- confirm & toast ---------- */
function confirmIn(box, html, okLabel, onOk, danger) {
  const el = $(box);
  el.innerHTML = `<p>${html}</p><div class="row"><button class="btn ${danger ? 'solid-danger' : 'primary'}" type="button" data-ok>${okLabel}</button><button class="btn" type="button" data-no>Отмена</button></div>`;
  el.hidden = false;
  $('[data-ok]', el).onclick = () => { el.hidden = true; onOk(); render(); };
  $('[data-no]', el).onclick = () => { el.hidden = true; };
  $('[data-ok]', el).focus();
}
let toastT = 0;
function toast(msg, ms = 3800, action) {
  const el = $('#toast'), bad = /^Не |не получилось|не удалось|ошибк|не загрузил/i.test(msg);
  el.innerHTML = `<span class="ti${bad ? ' err' : ''}" aria-hidden="true"><svg viewBox="0 0 24 24">${bad ? '<path d="M12 7v6M12 17h.01"/>' : '<path d="M5 12.5l4.5 4.5L19 7.5"/>'}</svg></span><span class="tt"></span>`;
  el.querySelector('.tt').textContent = msg;
  if (action) {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'tu';
    b.innerHTML = `<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" style="animation-duration:${ms}ms"/></svg>${esc(action.label)}`;
    b.addEventListener('click', () => { clearTimeout(toastT); el.hidden = true; action.fn(); });
    el.appendChild(b);
  }
  el.classList.remove('out'); el.hidden = true; void el.offsetWidth; el.hidden = false;
  clearTimeout(toastT); toastT = setTimeout(() => { el.classList.add('out'); toastT = setTimeout(() => { el.hidden = true; el.classList.remove('out'); }, 340); }, ms);
}

