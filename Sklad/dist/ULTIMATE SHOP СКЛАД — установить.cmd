function parseQty(v) {
  if (v == null) return null;
  let s = String(v).replace(/[\s  ]/g, '').replace(/(шт|pcs|pc)\.?$/i, '');
  if (!s) return null;
  s = s.replace(',', '.');
  if (!/^[-+]?(\d+\.?\d*|\.\d+)$/.test(s)) return null;
