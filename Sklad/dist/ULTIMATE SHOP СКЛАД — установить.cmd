});
$('#impArt').addEventListener('change', e => { IMP.m.art = +e.target.value; renderImport(); });
$('#impQty').addEventListener('change', e => { IMP.m.qty = +e.target.value; renderImport(); });
$('#impName').addEventListener('change', e => { IMP.m.name = +e.target.value; renderImport(); });
$('#impShip').addEventListener('change', e => { IMP.m.ship = +e.target.value; renderImport(); });
$('#impDate').addEventListener('change', e => { IMP.m.date = +e.target.value; renderImport(); });
$('#impStat').addEventListener('change', e => { IMP.m.status = +e.target.value; renderImport(); });
$('#impModes').addEventListener('change', e => { if (e.target.name === 'impMode') { IMP.mode = e.target.value; renderImport(); } });
$('#impApply').addEventListener('click', applyImport);
const dropPdfs = () => { for (const f of IMP.files) if (f.pdf) f.pdf.destroy().catch(() => {}); IMP.files = []; };
['#impX', '#impCancel'].forEach(s => $(s).addEventListener('click', () => { dropPdfs(); closeModal('#imp'); }));
['#cpyX', '#cpyClose'].forEach(s => $(s).addEventListener('click', () => closeModal('#cpy')));
$('#imp').addEventListener('mousedown', e => { if (e.target.id === 'imp') { dropPdfs(); closeModal('#imp'); } });
$('#cpy').addEventListener('mousedown', e => { if (e.target.id === 'cpy') closeModal('#cpy'); });

const tabTarget = () => ui.tab === 'stock' ? 'stock' : ui.tab === 'an' ? 'history' : 'orders';
document.addEventListener('paste', e => {
  if (!$('#imp').hidden || !$('#cpy').hidden || !['day', 'stock', 'an'].includes(ui.tab)) return;
  const ae = document.activeElement;
  if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.isContentEditable)) return;
  const t = e.clipboardData && e.clipboardData.getData('text/plain');
  if (!t || !/[\t\n]/.test(t.trim())) return;
  e.preventDefault(); fromText(t, tabTarget());
});
let dragN = 0;
const hasFiles = e => !!e.dataTransfer && Array.from(e.dataTransfer.types || []).includes('Files');
document.addEventListener('dragenter', e => { if (!hasFiles(e)) return; dragN++; $('#drop').textContent = {stock: 'Отпустите файл, чтобы загрузить остатки', history: 'Отпустите файл, чтобы загрузить историю продаж', orders: 'Отпустите файл, чтобы загрузить лист подбора'}[tabTarget()]; $('#drop').hidden = false; });
document.addEventListener('dragleave', e => { if (!hasFiles(e)) return; dragN = Math.max(0, dragN - 1); if (!dragN) $('#drop').hidden = true; });
document.addEventListener('dragover', e => { if (hasFiles(e)) e.preventDefault(); });
document.addEventListener('drop', e => {
  if (!hasFiles(e)) return;
  e.preventDefault(); dragN = 0; $('#drop').hidden = true;
  const fl = [...e.dataTransfer.files]; if (fl.length) loadFiles(tabTarget(), fl);
});
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') maps.forEach(m => { if (m.dirty.size) m.flush(); }); });

/* ---------- start ---------- */
async function start() {
  document.body.classList.add('loading');
  const saved = lsGet('sklad/tab');
  document.body.classList.toggle('emp', EMP);
  setTab(['home', 'day', 'buy', 'recv', 'stock', 'an', 'settings'].includes(saved) ? saved : EMP ? 'recv' : 'home');
  renderSettings(); render();
  let db = null;
  if (inViewer) {
    setSync('wait', 'Подключение…');
    const use = n => window.claude.use(n).catch(() => null);
    [db, DL, SAMPLE] = await Promise.all([use('db'), use('downloads'), use('sample')]);
    $('#hAiBtn').hidden = !SAMPLE;
  }
  Backend = db ? dbBackend(db) : localBackend();
  subscribe(); renderSettings();
}
// for the program's own tests: the internals are reachable only when the address ends with ?test
if (/[?&]test\b/.test(location.search)) window.SK = {parseRaw, parseArt, akey, sheetName, sheetCode, putSup, buyRows, plan, groupModels, stockAdd, render, orderModels, pavText, going, shipsOf, trimmedPage, twinSuggest,
  get SUP() { return SUP; }, get SENT() { return SENT; }, get ORD() { return ORD; }, get TWIN() { return TWIN; }, get MOVE() { return MOVE; }, get SKIP() { return SKIP; }, get stock() { return stock; }, get PO() { return PO; }, shortModel, sizeShow};
start();
})();
</script>
</body>
</html>
