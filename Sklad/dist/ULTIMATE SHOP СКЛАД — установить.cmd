@media (max-width:420px){.cnt{grid-template-columns:44px 1fr auto;gap:6px 8px}.step button{width:42px;height:42px}.step .cin{width:50px}}
.recv-model h4{margin:0;font:700 15px/1.3 var(--f-mono);word-break:break-all}
.szchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.szc{font:600 13px/1 var(--f-mono);padding:6px 8px;border-radius:6px;background:var(--surface-2);border:1px solid var(--line);white-space:nowrap}
.szc.old{background:var(--warn-soft);border-color:transparent;color:var(--warn)}
.szc.dead{background:var(--bad-soft);border-color:transparent;color:var(--bad)}
.szc.neg{background:var(--bad);color:#fff;border-color:transparent}
.mrow{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.mrow:last-child{border-bottom:0}
.mrow .tot{font:700 17px var(--f-mono);text-align:right;white-space:nowrap}
.mrow .tot small{display:block;font:500 12px var(--f-ui);color:var(--muted)}
.sortsel{width:auto;min-width:0;font-size:14px;padding:9px 10px}
details.rep{border:1.5px solid var(--line);border-radius:8px;padding:10px 14px}
details.rep+details.rep{margin-top:8px}
details.rep summary{cursor:pointer;display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;list-style:none}
details.rep summary::-webkit-details-marker{display:none}
details.rep summary b{font:800 14px var(--f-display)}
details.rep[open] summary{margin-bottom:10px}
.retrow{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;padding:8px 0;border-bottom:1px dashed var(--line)}
.retrow:last-child{border-bottom:0}
.retrow .btn{min-height:36px;padding:7px 10px;font-size:13px;margin-left:auto}
a.btn{text-decoration:none}
.btn.wa{background:var(--good);border-color:var(--good);color:var(--surface)}
.btn.wa:hover{filter:brightness(1.08)}
.supinfo{font-size:14px}
.supinfo.none{color:var(--muted)}
.pav>header .row{gap:6px}
.supform{display:grid;grid-template-columns:1fr 1fr auto auto;gap:10px;align-items:end;padding:12px 18px;border-bottom:1px solid var(--line);background:var(--surface-2)}
@media (max-width:640px){.supform{grid-template-columns:1fr 1fr}.supform .btn{grid-column:auto}}
.suptab td{padding:6px 8px 6px 0;border-top:1px solid var(--line);vertical-align:middle}
.suptab th{font:600 11px/1.2 var(--f-ui);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:left;padding:4px 8px 6px 0}
.suptab .in{padding:8px 10px;font-size:15px}
.suptab{width:100%;border-collapse:collapse}
.anparams{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;max-width:760px}
@media (max-width:640px){.anparams{grid-template-columns:1fr 1fr}}
.arow{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.arow:last-child{border-bottom:0}
.arow .tot{font:700 16px var(--f-mono);text-align:right;white-space:nowrap}
.arow .tot small{display:block;font:500 12px var(--f-ui);color:var(--muted)}
.why{font-size:13px;color:var(--muted);margin-top:4px}
.why b{color:var(--ink);font-weight:600}
.pavtag{font:700 11px/1 var(--f-mono);padding:4px 6px;border-radius:4px;background:var(--hazard);color:var(--accent)}

/* ===== v3: premium look — graphite, champagne gold, sidebar ===== */
:root{
  --bg:#F1F2F4; --surface:#FFFFFF; --surface-2:#F6F7F9; --ink:#121317; --muted:#656B74; --line:#E1E4E8;
  --accent:#121317; --accent-edge:#121317; --accent-ink:#FFFFFF; --accent-soft:#F5EFE3;
  --gold:#B08A3E; --gold-ink:#86672A; --gold-on-accent:#D9B76E; --bar:#6B717A; --bar-now:#B08A3E;
  --side:#111215; --side-2:#1B1D21; --side-ink:#ECEDEF; --side-muted:#8E939C; --side-line:#25282D; --side-gold:#D9B76E;
  --good:#1F7A4D; --good-soft:#E3F2EA; --warn:#98590A; --warn-soft:#FBEFDD; --bad:#B4372D; --bad-soft:#FBE7E4;
  --seg-good:#2E8A5C; --seg-warn:#D08A1E; --seg-bad:#C9463A;
  --focus:#2F62D8; --hazard:#121317; --scrim:rgba(10,11,13,.55);
  --shadow:0 1px 2px rgba(17,19,23,.05),0 12px 30px -18px rgba(17,19,23,.22);
  --r:14px;
  --f-display:"Tenor Sans","Golos Text","Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0C0D0F; --surface:#15171A; --surface-2:#1C1F23; --ink:#ECEDEF; --muted:#9BA0A9; --line:#272B31;
    --accent:#ECEDEF; --accent-edge:#ECEDEF; --accent-ink:#111215; --accent-soft:#2A2518;
    --gold:#E0BC70; --gold-ink:#E0BC70; --gold-on-accent:#86672A; --bar:#6A7079; --bar-now:#E0BC70;
    --side:#08090B; --side-2:#15171A; --side-line:#1E2125;
    --good:#5FCB91; --good-soft:#15301F; --warn:#F2A64B; --warn-soft:#37270F; --bad:#FF8074; --bad-soft:#3B1E1B;
    --seg-good:#3FA877; --seg-warn:#E0A040; --seg-bad:#E0645A;
    --focus:#80A8FF; --scrim:rgba(0,0,0,.65);
    --shadow:0 1px 2px rgba(0,0,0,.4),0 12px 30px -18px rgba(0,0,0,.7);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0C0D0F; --surface:#15171A; --surface-2:#1C1F23; --ink:#ECEDEF; --muted:#9BA0A9; --line:#272B31;
  --accent:#ECEDEF; --accent-edge:#ECEDEF; --accent-ink:#111215; --accent-soft:#2A2518;
  --gold:#E0BC70; --gold-ink:#E0BC70; --gold-on-accent:#86672A; --bar:#6A7079; --bar-now:#E0BC70;
  --side:#08090B; --side-2:#15171A; --side-line:#1E2125;
  --good:#5FCB91; --good-soft:#15301F; --warn:#F2A64B; --warn-soft:#37270F; --bad:#FF8074; --bad-soft:#3B1E1B;
  --seg-good:#3FA877; --seg-warn:#E0A040; --seg-bad:#E0645A;
  --focus:#80A8FF; --scrim:rgba(0,0,0,.65);
  --shadow:0 1px 2px rgba(0,0,0,.4),0 12px 30px -18px rgba(0,0,0,.7);
  color-scheme:dark;
}
body{background:var(--bg);font-size:15px}
.ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
.shell{display:grid;grid-template-columns:252px minmax(0,1fr);min-height:100vh}
.side{background:var(--side);color:var(--side-ink);display:flex;flex-direction:column;gap:26px;padding:24px 14px;position:sticky;top:env(safe-area-inset-top,0px);height:100vh;overflow-y:auto;z-index:20}
.side .brand{display:flex;gap:12px;align-items:center;padding:2px 8px;margin:0;min-width:0}
.mark{width:40px;height:40px;border-radius:11px;background:linear-gradient(140deg,#EACF95 0%,#B08A3E 100%);color:#16171A;display:grid;place-items:center;font:400 15px/1 var(--f-display);letter-spacing:.08em;flex:none;box-shadow:inset 0 0 0 1px rgba(255,255,255,.25)}
.side .logo{display:block;font:400 15px/1.15 var(--f-display);letter-spacing:.16em;text-transform:uppercase;color:var(--side-ink);white-space:nowrap}
.side .logo span{display:block;color:var(--side-gold);font-size:10.5px;letter-spacing:.42em;margin-top:6px}
.side .tabs{display:flex;flex-direction:column;gap:2px;border:0;margin:0;overflow:visible}
.side .tab{color:var(--side-muted);padding:11px 12px;border:0;border-radius:10px;font:500 14.5px/1.2 var(--f-ui);gap:12px;justify-content:flex-start;margin:0;width:100%;transition:background .15s,color .15s}
.side .tab:hover{color:var(--side-ink);background:var(--side-2)}
.side .tab[aria-selected="true"]{color:var(--side-ink);background:var(--side-2)}
.side .tab[aria-selected="true"] .ic{color:var(--side-gold)}
.side .tab .badge{margin-left:auto;background:var(--side-2);border:1px solid var(--side-line);color:var(--side-ink);font:600 11px/1 var(--f-ui);padding:4px 7px}
.side .tab .badge.hot{background:var(--side-gold);border-color:transparent;color:#16171A}
.side-foot{margin-top:auto;padding:14px 10px 2px;border-top:1px solid var(--side-line)}
.side .sync{color:var(--side-muted);max-width:none}
.app{max-width:1200px;width:100%;margin:0;padding-inline:36px;padding-block:28px 72px;min-width:0}
.top{display:flex;align-items:flex-end;gap:16px 28px;flex-wrap:wrap;padding-block:0 22px;margin-bottom:22px;border-bottom:1px solid var(--line)}
.top .title{margin-right:auto;min-width:0}
.eyebrow{font:500 12px/1 var(--f-ui);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.top h1{font:400 34px/1.1 var(--f-display);letter-spacing:.06em;margin:10px 0 0;text-transform:uppercase}
.kpis{display:flex;gap:10px;flex-wrap:wrap}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 16px;min-width:128px;box-shadow:var(--shadow);gap:3px}
.kpi .num{font:600 22px/1.1 var(--f-ui)}
.kpi .lbl{font-size:12px;color:var(--muted)}
.stripe{display:none}
.card{border-radius:var(--r);box-shadow:var(--shadow);border-color:var(--line);padding:22px}
h2{font:600 18px/1.3 var(--f-ui)}
h3{font:600 16px/1.3 var(--f-ui)}
.hint{color:var(--muted)}
.tile{border-radius:var(--r);box-shadow:var(--shadow);border-color:var(--line);padding:18px 20px;gap:8px}
.tile .k{font-size:11px;letter-spacing:.14em}
.tile .v{font:600 32px/1.05 var(--f-ui);letter-spacing:-.01em}
.tile .v small{font:500 14px var(--f-ui);color:var(--muted)}
.tile.hot{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.tile.hot .k{color:var(--gold-on-accent);opacity:1}
.tile.hot .s,.tile.hot .v small{color:var(--accent-ink);opacity:.72}
.btn{border-radius:10px;border-width:1px;background:var(--surface);transition:background .15s,border-color .15s,opacity .15s}
.btn:hover{border-color:color-mix(in srgb,var(--ink) 35%,var(--line))}
.btn:active{transform:translateY(1px)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{opacity:.88;border-color:var(--accent)}
.btn.ghost{background:transparent}
.btn .ic{width:17px;height:17px}
.btn.wa{background:var(--good);border-color:var(--good);color:var(--surface)}
.in{border-width:1px;border-radius:10px}
.in:focus{border-color:var(--ink);box-shadow:0 0 0 3px color-mix(in srgb,var(--ink) 12%,transparent)}
.seg{border-radius:11px;padding:3px;background:var(--surface-2);border:1px solid var(--line);gap:2px}
.seg button{border-radius:8px;padding:9px 12px}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08),0 0 0 1px var(--line)}
.tw{border-radius:12px;border-color:var(--line)}
.t th{background:var(--surface-2);font-size:10.5px;letter-spacing:.12em}
.t tbody tr:hover td{background:var(--surface-2)}
.chip{gap:6px;padding:5px 9px 5px 8px}
.chip.good::before,.chip.warn::before,.chip.bad::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}
.badge.hot{background:var(--gold);color:#16171A;border-color:transparent}
.fill{background:var(--gold)}
.steps li{border-radius:12px;background:var(--surface);box-shadow:var(--shadow)}
.steps li::before{background:var(--ink);color:var(--surface);border-radius:6px;font-family:var(--f-ui)}
.pavtag{background:var(--ink);color:var(--surface)}
.pav{border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden}
.pav>header{background:var(--surface-2)}
.pav>header h3{font:400 16px/1.2 var(--f-display);letter-spacing:.12em;text-transform:uppercase}
.go{border-width:1px;border-radius:12px;background:var(--surface)}
.go b{font:400 15px var(--f-display);letter-spacing:.1em}
details.rep{border-width:1px;border-radius:12px}
details.rep summary b{font:400 14px var(--f-display);letter-spacing:.1em}
.notice{border-radius:var(--r);border-width:1px;border-color:color-mix(in srgb,var(--gold) 55%,transparent);background:var(--accent-soft)}
.confirm{border-radius:12px;border-width:1px}
.mode,.opt input{border-width:1px}
.mode{border-radius:12px}
.sheet{border-radius:18px}
.toast{border-radius:12px;padding:13px 18px;box-shadow:0 12px 40px -12px rgba(0,0,0,.45)}
.ph{border-radius:8px}
.step button{border-width:1px;border-radius:12px}
.pane{animation:paneIn .2s ease-out}
@keyframes paneIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.pane{animation:none}}
/* day: share of shipments by state */
.stack>*,.card,.pane,main{min-width:0}
.daybar{padding:16px 20px;display:grid;gap:12px}
.segbar{display:flex;gap:2px;height:12px;border-radius:6px;overflow:hidden;background:var(--surface-2)}
.segbar span{min-width:4px}
.segleg{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:13.5px;color:var(--muted)}
.segleg b{color:var(--ink);font-variant-numeric:tabular-nums}
.segleg i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:7px;vertical-align:0}
/* analysis chart */
.chart{position:relative;margin-top:6px}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.chart .grid{stroke:var(--line);stroke-width:1}
.chart .tick{fill:var(--muted);font:11px var(--f-ui);font-variant-numeric:tabular-nums}
.chart .val{fill:var(--ink);font:600 12px var(--f-ui)}
.chart .b{fill:var(--bar)}
.chart .b.now{fill:var(--bar-now)}
.chart .b.dim{opacity:.35}
.chart .hit{fill:transparent;cursor:crosshair}
.ctip{position:absolute;pointer-events:none;background:var(--ink);color:var(--surface);padding:7px 10px;border-radius:8px;font:500 12.5px/1.3 var(--f-ui);white-space:nowrap;transform:translate(-50%,calc(-100% - 10px));box-shadow:0 8px 24px -10px rgba(0,0,0,.5)}
.ctip b{font-weight:700}
/* order sheet preview */
.ordsheet{max-width:760px}
.ordsteps{margin:0 0 14px;padding:0;list-style:none;display:grid;gap:8px;counter-reset:st}
.ordsteps li{counter-increment:st;display:grid;grid-template-columns:26px 1fr;gap:10px;align-items:start;font-size:14.5px;color:var(--muted)}
.ordsteps li::before{content:counter(st);width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--accent-ink);font:600 13px/1 var(--f-ui)}
.ordsteps b{color:var(--ink);font-weight:600}
.ordpages{display:grid;gap:14px;justify-items:center;background:var(--surface-2);border-radius:14px;padding:16px;min-height:220px;align-content:start}
.ordpage{margin:0;width:100%;max-width:560px;display:grid;gap:8px}
.ordpage img{width:100%;height:auto;display:block;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.08),0 10px 28px -12px rgba(0,0,0,.35);background:#fff;cursor:grab;-webkit-user-drag:element;transition:transform .35s var(--spring),box-shadow .25s}
.ordpage img:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,0,0,.08),0 18px 36px -14px rgba(0,0,0,.45)}
.ordpage img:active{cursor:grabbing}
.ordpage.dragging img{opacity:.55;transform:scale(.98)}
.ordpage figcaption{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;font-size:13px;color:var(--muted)}
.ordpage .draghint{display:inline-flex;align-items:center;gap:6px}
.ordpage .draghint .ic{width:16px;height:16px}
@media (hover:none){.ordsteps .fine,.ordpage .draghint{display:none}.ordpage figcaption{justify-content:flex-end}}
@media (hover:hover){.ordsteps .touch{display:none}}
.ordpages .ordwait{align-self:center;color:var(--muted);font-size:14px;display:flex;align-items:center;gap:10px}
.ordpages .ordwait i{width:18px;height:18px;border-radius:50%;border:2px solid var(--line);border-top-color:var(--gold);animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
/* help button & tour */
.helpbtn{appearance:none;border:0;background:transparent;color:var(--side-muted);display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;margin:0 0 10px;border-radius:10px;font:500 14px/1.2 var(--f-ui);cursor:pointer;transition:background .15s,color .15s}
.helpbtn:hover{color:var(--side-ink);background:var(--side-2)}
.helpbtn .ic{color:var(--side-gold)}
.helpbtn:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.tour{position:fixed;inset:0;z-index:90}
.tour-ring{position:fixed;border-radius:14px;box-shadow:0 0 0 9999px rgba(8,9,11,.64);outline:2px solid var(--side-gold);outline-offset:0;pointer-events:none;transition:top .32s cubic-bezier(.2,.8,.2,1),left .32s cubic-bezier(.2,.8,.2,1),width .32s cubic-bezier(.2,.8,.2,1),height .32s cubic-bezier(.2,.8,.2,1)}
.tour-ring.none{outline-color:transparent}
.tour-pop{position:fixed;width:min(390px,calc(100vw - 24px));background:var(--surface);color:var(--ink);border-radius:16px;padding:20px 20px 16px;box-shadow:0 24px 60px -12px rgba(0,0,0,.45),0 0 0 1px var(--line);overflow:hidden;transition:top .32s cubic-bezier(.2,.8,.2,1),left .32s cubic-bezier(.2,.8,.2,1)}
.tour-bar{position:absolute;left:0;right:0;top:0;height:3px;background:var(--surface-2)}
.tour-bar i{display:block;height:100%;background:var(--gold);transition:width .32s}
.tour-n{font:600 11.5px/1 var(--f-ui);letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin:4px 0 10px}
.tour-pop h3{font:600 19px/1.25 var(--f-ui);margin:0 0 8px}
.tour-pop p{margin:0;color:var(--muted);font-size:15px;line-height:1.5}
.tour-act{display:flex;align-items:center;gap:8px;margin-top:18px}
.tour-act .grow{flex:1}
.tour-act #tourSkip{padding-inline:4px}
@media (prefers-reduced-motion:reduce){.tour-ring,.tour-pop,.tour-bar i{transition:none}}
/* pavilion picker */
.pavpick{scroll-margin-top:16px}
.pavpick .lhead{margin-bottom:12px}
.pp-nav{display:flex;gap:8px;align-items:center}
.pp-nav select{flex:1;min-width:0;font-weight:600}
.btn.ico{padding-inline:0;width:44px;justify-content:center;font-size:18px}
.ppchips{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:8px}
.ppc{appearance:none;cursor:pointer;text-align:left;position:relative;display:flex;flex-direction:column;gap:3px;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:inherit;transition:border-color .15s,background .15s}
.ppc b{font:600 14px/1.2 var(--f-mono);letter-spacing:.02em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:18px}
.ppc span{font-size:12.5px;color:var(--muted)}
.ppc .ic{position:absolute;top:9px;right:9px;width:16px;height:16px;color:var(--good);stroke-width:2.4}
.ppc:hover{border-color:var(--ink)}
.ppc.zero{opacity:.55}
.ppc.all b{font-family:var(--f-ui)}
.ppc[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.ppc[aria-pressed="true"] span{color:inherit;opacity:.72}
.ppc[aria-pressed="true"] .ic{color:inherit}
.ppc:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
/* buy: ×, move, join */
.mhead{display:flex;align-items:flex-start;gap:8px}
.mhead h4{flex:1;min-width:0;padding-top:6px}
.mact{display:flex;gap:6px;flex-shrink:0}
.btn.sm{min-height:34px;padding:6px 10px;font-size:13px;gap:6px}
.btn.sm .ic{width:16px;height:16px}
.xx{appearance:none;flex-shrink:0;width:34px;height:34px;border-radius:50%;border:1.5px solid var(--line);background:var(--surface);color:var(--muted);font:400 22px/1 var(--f-ui);cursor:pointer;display:inline-grid;place-items:center;padding:0 0 2px;transition:background-color .15s,border-color .15s,color .15s,transform .4s var(--spring)}
.xx:hover{color:#fff;background:var(--bad);border-color:var(--bad)}
.xx:active{transform:scale(.88)}
.xx:focus-visible,.ppx:focus-visible,.skc:focus-visible,.lnk:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.pav>header{position:relative;padding-right:64px}
.pav>header .xx{position:absolute;top:12px;right:16px}
@media (max-width:560px){.pav>header{padding-right:56px}.pav>header .xx{top:9px;right:12px}}
@media (max-width:760px){.mact .btn span{display:none}.mact .btn.sm{width:34px;padding:0}}
.mnote{display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center;margin-top:6px;font-size:12.5px;color:var(--muted)}
