<script>
(() => {
'use strict';

/* ---------- helpers ---------- */
const NB = 16, DAYMS = 86400000;
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const round = n => Math.round(n * 1000) / 1000;
const nf = new Intl.NumberFormat('ru-RU', {maximumFractionDigits: 3});
const fmt = n => nf.format(n || 0);
const qv = n => String(n).replace('.', ',');
const coll = new Intl.Collator('ru', {numeric: true, sensitivity: 'base'});
const plural = (n, f) => { const a = Math.abs(Math.trunc(n)) % 100, b = a % 10; return f[(a > 10 && a < 20) ? 2 : b === 1 ? 0 : (b >= 2 && b <= 4) ? 1 : 2]; };
const W = {ship: ['отправление', 'отправления', 'отправлений'], art: ['артикул', 'артикула', 'артикулов'], row: ['строка', 'строки', 'строк'], file: ['файл', 'файла', 'файлов'], pos: ['позиция', 'позиции', 'позиций'], pav: ['павильон', 'павильона', 'павильонов'], model: ['модель', 'модели', 'моделей'], day: ['день', 'дня', 'дней'], pur: ['закупка', 'закупки', 'закупок']};
const cnt = (n, w) => `${fmt(n)} ${plural(n, w)}`;
const inPav = n => `в ${fmt(n)} ${plural(n, ['павильоне', 'павильонах', 'павильонах'])}`;
const trunc = (s, n) => { s = String(s ?? ''); return s.length > n ? s.slice(0, n - 1) + '…' : s; };
const range = n => Array.from({length: n}, (_, i) => i);
const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
const p2 = x => String(x).padStart(2, '0');
const when = t => { const d = new Date(t); return `${p2(d.getDate())}.${p2(d.getMonth() + 1)} ${p2(d.getHours())}:${p2(d.getMinutes())}`; };
const dm = t => { const d = new Date(t); return `${p2(d.getDate())}.${p2(d.getMonth() + 1)}`; };
const daysSince = t => t ? Math.max(0, Math.floor((Date.now() - t) / DAYMS)) : null;
const lsGet = k => { try { return localStorage.getItem(k); } catch { return null; } };
const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
let EMP = lsGet('sklad/emp') === '1';   // employee mode on this device: receiving and stock only
const lsOk = () => { try { localStorage.setItem('sklad/ls', '1'); return localStorage.getItem('sklad/ls') === '1'; } catch { return false; } };
const newId = p => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
const inViewer = !!(window.claude && typeof window.claude.use === 'function');
const APP_VERSION = '2026-10-05.1';
const T0 = performance.now();
const DEV = (() => { let d = lsGet('sklad/dev'); if (!d || !/^[a-z0-9]{4,12}$/.test(d)) { d = Math.random().toString(36).slice(2, 8); lsSet('sklad/dev', d); } return d; })();

/* ---------- article normalisation ---------- */
const DEF = {latin: true, zeros: true, punct: true, pav: true, price: true, supplier: 'ТЦ Москва', anDays: 3, anLead: 1, anWin: 14, deadDays: 30, sizes: 'S=42, M=44, L=46, XL=48, 2XL=50, 3XL=52', kv: 0};
const KEYV = 2;   // how article keys are built; data saved with an older kv is re-keyed once
const NUMS = {anDays: [1, 30], anLead: [0, 14], anWin: [3, 90], deadDays: [7, 180]};
let S = {...DEF};
const CYR = {'А':'A','В':'B','Е':'E','Ё':'E','К':'K','М':'M','Н':'H','О':'O','Р':'P','С':'C','Т':'T','У':'Y','Х':'X'};
// pavilions are stored with Latin look-alikes; sort them as the Russian letters they are (А, Б, В, Г…)
const LAT2CYR = {A: 'А', B: 'В', E: 'Е', K: 'К', M: 'М', H: 'Н', O: 'О', P: 'Р', C: 'С', T: 'Т', Y: 'У', X: 'Х'};
const byPav = (a, b) => coll.compare(a ? a.replace(/[ABEKMHOPCTYX]/g, c => LAT2CYR[c]) : 'яяя', b ? b.replace(/[ABEKMHOPCTYX]/g, c => LAT2CYR[c]) : 'яяя');
const latinUp = s => String(s ?? '').toUpperCase().replace(/[АВЕЁКМНОРСТУХ]/g, c => CYR[c]);
